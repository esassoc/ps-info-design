---
// Salmon Habitat Indicator report — the page the landing table opens for
// SHI = VSI+ and SHI ≠ VSI indicators (deck speaker notes, slide 6). The
// content is the Salmon Habitat Indicator field, rendered as one report box
// with only the subfields switched on for that indicator. A VSI+ report links
// back to the Vital Sign Indicator it extends; that page links here.
// Contract: src/data/contracts/salmon-habitat-indicators.md
import PsInfoVsProdChrome from '../../../../layouts/PsInfoVsProdChrome.astro';
import PsInfoVsiDetailHeader from '../../../../components/psinfo/PsInfoVsiDetailHeader.astro';
import PsInfoShiReportFacts from '../../../../components/psinfo/PsInfoShiReportFacts.astro';
import PsInfoShiReportField from '../../../../components/psinfo/PsInfoShiReportField.astro';
import {
  CATEGORY_BY_SLUG,
  SALMON_HABITAT_INDICATORS,
  VS_SITE,
  hasShiReport,
  shiRoutes,
  vitalSignHref,
  vsiHref,
} from '../../../../data/pages/salmon-habitat-indicators';
import { withBase } from '../../../../lib/base';
import { SHI_RELATIONSHIP_LABEL, type SalmonHabitatIndicator } from '../../../../data/shi-domain';

export function getStaticPaths() {
  return SALMON_HABITAT_INDICATORS.filter(hasShiReport).map((indicator) => ({
    params: { slug: indicator.slug },
    props: { indicator },
  }));
}

interface Props {
  indicator: SalmonHabitatIndicator;
}
const { indicator } = Astro.props;
const vs = indicator.vitalSign;
const shi = indicator.salmonHabitatIndicator;
const parentVsi = indicator.vitalSignIndicator ? { name: indicator.name, href: vsiHref(indicator)! } : undefined;
const headerImage = `/photos/vital-signs/headers/vs-goal${vs.goalId}-header.jpg`;
const activeGoal = vs.goalId === 7 ? 'functioning-habitat' : 'healthy-water-quality';
---
<!-- manifest:
  layout: PsInfoVsProdChrome > stack(xl) spine
  sections:
    - indicator header          -> ps-info-vsi-detail-header
    - record line               -> ps-info-shi-report-facts
    - salmon habitat field box  -> ps-info-shi-report-field
-->
<PsInfoVsProdChrome
  title={`Vital Signs | Salmon Habitat Indicators | ${indicator.name}`}
  {headerImage}
  hueVar={vs.goalHueVar}
  {activeGoal}
  trail={[
    { label: 'About the Vital Signs', href: `${VS_SITE}/About` },
    { label: 'All Indicators', href: withBase(shiRoutes.allIndicators) },
    { label: 'Salmon Habitat Indicators', href: withBase(shiRoutes.landing) },
    { label: indicator.name },
  ]}
>
  <div class="stack" data-gap="xl">
    <PsInfoVsiDetailHeader
      name={indicator.name}
      vitalSign={{ name: vs.name, href: vitalSignHref(vs) }}
      hueVar={vs.goalHueVar}
    />
    <PsInfoShiReportFacts
      category={CATEGORY_BY_SLUG[shi.category]}
      relationship={SHI_RELATIONSHIP_LABEL[shi.relationship]}
      vitalSign={{ name: vs.name, href: vitalSignHref(vs) }}
      vitalSignIndicator={parentVsi}
    />
    <PsInfoShiReportField field={shi.field} indicatorName={indicator.name} />
  </div>
</PsInfoVsProdChrome>
