---
// Salmon Habitat Indicators — landing page, inside today's Vital Signs site.
// Built from PSP's SHI mock-up (v29, 2026-08-28), revised after the
// 2026-10-13 kickoff (DELTA-1347): logo lockup and About text, the life cycle
// loop over a full-width habitat graphic that follows the fish, landmarks that
// magnify on hover, a link to the plain list view, and the table of all
// Salmon Habitat Indicators with status and no Type column. Buttons and
// graphic zones filter the table.
// Contract: src/data/contracts/salmon-habitat-indicators.md
import PsInfoVsProdChrome from '../../../layouts/PsInfoVsProdChrome.astro';
import PsInfoEpicMark from '../../../components/psinfo/PsInfoEpicMark.astro';
import PsInfoShiHero from '../../../components/psinfo/PsInfoShiHero.astro';
import PsInfoShiHabitatExplorer from '../../../components/psinfo/PsInfoShiHabitatExplorer.astro';
import PsInfoSectionTitle from '../../../components/psinfo/PsInfoSectionTitle.astro';
import PsInfoShiIndicatorsGrid from '../../../components/psinfo/PsInfoShiIndicatorsGrid.astro';
import {
  HABITAT_CATEGORIES,
  SHI_ABOUT,
  SHI_GRID_HEADING,
  SHI_GRID_ROWS,
  SHI_LOGO,
  SHI_SITE_NAME,
  SHI_SUBTITLE,
  VS_SITE,
  shiRoutes,
} from '../../../data/pages/salmon-habitat-indicators';
import { withBase } from '../../../lib/base';
---
<!-- manifest:
  layout: PsInfoVsProdChrome > stack(2xl) spine
  sections:
    - title band, logo, About  -> ps-info-epic-mark > ps-info-shi-hero
    - life-cycle graphic + habitat buttons -> ps-info-epic-mark > ps-info-shi-habitat-explorer
    - table heading            -> ps-info-section-title
    - indicator table          -> ps-info-epic-mark > ps-info-shi-indicators-grid
-->
<PsInfoVsProdChrome
  title="Salmon Habitat Indicators"
  trail={[
    { label: 'About the Vital Signs', href: `${VS_SITE}/About` },
    { label: 'All Indicators', href: withBase(shiRoutes.allIndicators) },
    { label: 'Salmon Habitat Indicators' },
  ]}
>
  <div class="stack" data-gap="2xl">
    <PsInfoEpicMark story="DELTA-1347" label="Logo and About">
      <PsInfoShiHero name={SHI_SITE_NAME} subtitle={SHI_SUBTITLE} logo={SHI_LOGO} aboutParagraphs={SHI_ABOUT} />
    </PsInfoEpicMark>
    <PsInfoEpicMark story="DELTA-1347" label="Habitat diorama">
      <PsInfoShiHabitatExplorer categories={HABITAT_CATEGORIES} listHref={shiRoutes.list} />
    </PsInfoEpicMark>
    <div class="stack" data-gap="md">
      <PsInfoSectionTitle title={SHI_GRID_HEADING} size="lg" />
      <PsInfoEpicMark story="DELTA-1347" label="Indicator table">
        <PsInfoShiIndicatorsGrid rows={SHI_GRID_ROWS} categories={HABITAT_CATEGORIES} label="All Salmon Habitat Indicators" />
      </PsInfoEpicMark>
    </div>
  </div>
</PsInfoVsProdChrome>
