---
// Vital Signs home + All Indicators, combined (DELTA-912, round 1).
// One page in the live Vital Signs chrome: the wheel as the primary graphic
// with the indicator roll-up in its margin, then the All Indicators tree
// (with the SHI marks from DELTA-1346), then Contributing Partners. Pressing a
// roll-up row filters the tree to those indicators.
// The roll-up counts Vital Sign Indicators only (GOALS); the tree shows the
// SHI rows too (SHI_GOALS), as the shipped All Indicators prototype does.
import PsInfoVsProdChrome from '../../../layouts/PsInfoVsProdChrome.astro';
import PsInfoVsHomeOverview from '../../../components/psinfo/PsInfoVsHomeOverview.astro';
import PsInfoVsWheel from '../../../components/psinfo/PsInfoVsWheel.astro';
import PsInfoVitalSignsIntro from '../../../components/psinfo/PsInfoVitalSignsIntro.astro';
import PsInfoVsRollup from '../../../components/psinfo/PsInfoVsRollup.astro';
import PsInfoSectionTitle from '../../../components/psinfo/PsInfoSectionTitle.astro';
import PsInfoVsFancyTree from '../../../components/psinfo/PsInfoVsFancyTree.astro';
import PsInfoVsPartners from '../../../components/psinfo/PsInfoVsPartners.astro';
import PsInfoEpicMark from '../../../components/psinfo/PsInfoEpicMark.astro';
import { GOALS, ABOUT_VITAL_SIGNS_URL, VITAL_SIGNS_SITE } from '../../../data/pages/goals';
import { ESPANOL_LINK, INTRO_PARAGRAPHS } from '../../../data/pages/vital-signs';
import { SHI_GOALS, SHI_MARKED_HREFS } from '../../../data/pages/salmon-habitat-indicators';

const TREE_ID = 'tree-home';
---
<!-- manifest:
  layout: PsInfoVsProdChrome > stack(2xl) spine
  sections:
    - wheel + roll-up rail      -> psinfo-vs-home-overview (main: ps-info-epic-mark > psinfo-vs-wheel; rail: psinfo-vital-signs-intro, ps-info-epic-mark > psinfo-vs-rollup)
    - all indicators heading    -> psinfo-section-title
    - all indicators tree       -> ps-info-epic-mark > psinfo-vs-fancy-tree (statusFilterable, SHI marks)
    - contributing partners     -> psinfo-vs-partners
-->
<PsInfoVsProdChrome
  title="Vital Signs"
  hiddenHeading="Puget Sound Vital Signs"
  trail={[
    { label: 'About the Vital Signs', href: ABOUT_VITAL_SIGNS_URL },
    { label: 'All Indicators' },
  ]}
>
  <div class="stack" data-gap="2xl">
    <PsInfoVsHomeOverview>
      <PsInfoEpicMark story="DELTA-912" label="Wheel beside the roll-up">
        <PsInfoVsWheel size="compact" />
      </PsInfoEpicMark>
      <PsInfoVitalSignsIntro slot="rail" espanolLink={ESPANOL_LINK} paragraphs={[INTRO_PARAGRAPHS[0]]} variant="margin" />
      <PsInfoEpicMark slot="rail" story="DELTA-912" label="Indicator roll-up">
        <PsInfoVsRollup goals={GOALS} treeId={TREE_ID} />
      </PsInfoEpicMark>
    </PsInfoVsHomeOverview>

    <div class="stack" data-gap="md">
      <PsInfoSectionTitle title="All Indicators" size="lg" />
      <PsInfoEpicMark story="DELTA-912" label="All Indicators with status filter">
      <PsInfoVsFancyTree
        goals={SHI_GOALS}
        colorCoded={true}
        expandedLevels={1}
        treeId={TREE_ID}
        salmonMarked={SHI_MARKED_HREFS}
        statusFilterable={true}
        downloadHref={`${VITAL_SIGNS_SITE}/VitalSignIndicator/ViewAll`}
      />
      </PsInfoEpicMark>
    </div>

    <PsInfoVsPartners linkTo="website" />
  </div>
</PsInfoVsProdChrome>
