---
// PsInfoCirTitle — the head of prod's Complete Indicator Report: the
// "Vital Sign Indicators" chevron chip, the indicator name as the page h1,
// and "View in Vital Signs" at right (to the indicator's Vital Signs page).
//
// bcn-lego-checked: checked esa-breadcrumbs (separator trail, no filled
// chevron chip) and esa-page-header (title/actions; no chip or brand bar).
// The chip is prod's own report header; psinfo-cir-title is the reusable home.
import { withBase } from '../../lib/base';

interface Props {
  /** Indicator name, the page h1. */
  name: string;
  /** The chip: the indicator collection, linking to its list. */
  collection: { label: string; href: string };
  /** The indicator's page on the Vital Signs site. */
  vitalSignsHref: string;
}
const { name, collection, vitalSignsHref } = Astro.props;
const href = (h: string) => (/^https?:/.test(h) ? h : withBase(h));
---
<header class="cirtitle">
  <div class="cirtitle__trail">
    <a class="cirtitle__chip" href={href(collection.href)}>{collection.label}</a>
    <h1 class="cirtitle__name">{name}</h1>
  </div>
  <a class="cirtitle__vs" href={href(vitalSignsHref)}>View in Vital Signs</a>
</header>

<style>
  .cirtitle {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: var(--spacing-300) var(--spacing-500);
  }
  .cirtitle__trail { display: flex; align-items: center; flex-wrap: wrap; gap: var(--spacing-300) var(--spacing-500); }
  .cirtitle__chip {
    display: inline-flex; align-items: center; min-height: 2.5rem;
    padding: 0 var(--spacing-600) 0 var(--spacing-400);
    background: var(--ps-info-blue-800); color: #ffffff;
    clip-path: polygon(0 0, calc(100% - 0.75rem) 0, 100% 50%, calc(100% - 0.75rem) 100%, 0 100%);
    font-size: 1.125rem; font-weight: var(--font-weight-semibold);
    text-transform: uppercase; text-decoration: none;
  }
  .cirtitle__chip:hover { background: var(--ps-info-blue-900); }
  .cirtitle__chip:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: 2px; }
  .cirtitle__name {
    margin: 0;
    font-size: 1.125rem; font-weight: var(--font-weight-medium); line-height: 1.3;
    text-transform: uppercase; color: var(--ps-info-blue-800);
  }
  .cirtitle__vs {
    font-size: var(--ps-info-text-body); color: var(--color-text-link);
    text-decoration: underline; text-underline-offset: 2px;
  }
  .cirtitle__vs:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: 2px; }
</style>
