---
// PsInfoEpicStory: one story's section body on its epic page, under the
// story's band. Two nested psinfo-groups: the story's one illustrative example
// (exampleOf), named with its case label and an Open Page button (carrying
// ?story= when the page sits under more than one story), with the numbered
// labels beside its annotated shots (psinfo-epic-shot); then Pages, the rows of
// every page that answers the story. Shots come from scripts/epic-shots.mjs as
// src/data/epics/shots/<epic key>.json; a missing file or entry renders the
// example's band alone.
// prose-prop-checked: `story` is a Jira story record (key, title, pages), never page copy
// bcn-lego-checked: no esa- lego pairs a numbered label list with annotated images; the bands and rows are psinfo-group, the button esa-button. Checked Beacon shared ui components (none); psinfo-epic-story is the reusable home
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import '@esa/tokens/typography.css';
import '@esa/tokens/a11y.css';
import '@esa/tokens/layouts.css';
import '../../styles/epic-marks.css';
import type { Epic, EpicShot, EpicShotMark, EpicShots, EpicStory } from '../../data/epics/types';
import { epicSteps, exampleOf, stepHref, storySlug } from '../../data/epics/index';
import { withBase } from '../../lib/base';
import PsInfoEpicShot from './PsInfoEpicShot.astro';
import PsInfoGroup from './PsInfoGroup.astro';

interface Props {
  epic: Epic;
  /** The Jira story record this section shows (key, title, pages). */
  story: EpicStory;
}
const { epic, story } = Astro.props;

const SHOT_FILES = import.meta.glob<EpicShots>('../../data/epics/shots/*.json', { eager: true, import: 'default' });
const storyShots = SHOT_FILES[`../../data/epics/shots/${epic.key.toLowerCase()}.json`]?.[story.key] ?? {};

const byN = (a: EpicShotMark, b: EpicShotMark) => a.n - b.n;

const page = exampleOf(story);
const shots: EpicShot[] = storyShots[page.route] ?? [];
// One label per number across the page's shots, in mark order.
const marks = new Map<number, EpicShotMark>();
for (const m of shots.flatMap((s) => s.marks).sort(byN)) if (!marks.has(m.n)) marks.set(m.n, m);
const labels = [...marks.values()];
const slug = storySlug(story);
const href = withBase(stepHref(epic, { story, page }));
const annotated = shots.map((shot) => ({
  shot,
  alt: shot.marks.length ? `${page.title}, outlined: ${[...shot.marks].sort(byN).map((m) => m.label).join(', ')}` : page.title,
}));
const rows = epicSteps(epic)
  .filter((s) => s.story === story)
  .map((step) => ({ href: withBase(stepHref(epic, step)), title: step.page.title, label: step.page.label }));
---
<div class="epicstory stack" data-gap="xl">
  <PsInfoGroup id={`${slug}-example`} level={3}>
    <Fragment slot="title">
      <span>{page.title}</span>
      {page.label && <EsaBadge value={page.label} variant="neutral" size="sm" />}
    </Fragment>
    <EsaButton slot="actions" variant="secondary" size="sm" href={href} iconRight="arrow-right">Open Page</EsaButton>
    {annotated.length > 0 && (
      <div class="epicstory__body sidebar" data-side="end" data-gap="lg">
        <ol class="epicstory__labels" role="list">
          {labels.map((m) => (
            <li class="epicstory__label">
              <span class="epic-num typography-label-sm-strong" aria-hidden="true">{m.n}</span>
              <span class="typography-body-md"><span class="visually-hidden">{m.n}, </span>{m.label}</span>
            </li>
          ))}
        </ol>
        <div class="stack" data-gap="lg">
          {annotated.map(({ shot, alt }) => <PsInfoEpicShot shot={shot} alt={alt} />)}
        </div>
      </div>
    )}
  </PsInfoGroup>
  <PsInfoGroup id={`${slug}-pages`} level={3} rows={rows}>
    <Fragment slot="title">Pages</Fragment>
  </PsInfoGroup>
</div>

<style>
  .epicstory { padding-block-start: var(--spacing-200); }
  .epicstory__body { padding-block-start: var(--spacing-200); }
  .epicstory__labels {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: var(--spacing-300);
  }
  .epicstory__label {
    display: flex; align-items: baseline; gap: var(--spacing-200);
    color: var(--color-text-primary);
  }
</style>
