---
// PsInfoCirMap — the body of the Complete Indicator Report's Map box (prod
// Indicator/Detail #map): an embedded map frame (an ArcGIS web app) or an
// uploaded map image, then the caption and the optional external map link.
// Used by the SHI Map subfield, so it offers the same modes as the report's
// Map box.
//
// bcn-lego-checked: no esa- lego wraps an embedded map frame or map image
// with a caption (no esa-map; logged in docs/system-improvement-ledger.md);
// checked Beacon (no embed figure). psinfo-cir-map is the reusable home.
import { withBase } from '../../lib/base';
import type { IndicatorMap } from '../../data/shi-domain';

interface Props {
  map: IndicatorMap;
}
const { map } = Astro.props;
const local = (src: string) => (src.startsWith('/') ? withBase(src) : src);
---
<figure class="cirmap">
  {map.mode === 'embeddedUrl' && (
    <iframe class="cirmap__frame" src={local(map.url)} title={map.title} style={`height: ${map.height ?? 500}px`} allowfullscreen loading="lazy"></iframe>
  )}
  {map.mode === 'image' && (
    <a href={local(map.src)}>
      <img src={local(map.src)} alt={map.alt} width={map.width} height={map.height} loading="lazy" />
    </a>
  )}
  {map.caption && <figcaption class="cirmap__caption">{map.caption}</figcaption>}
  {map.externalLink && <p><a href={map.externalLink.url}>{map.externalLink.name}</a></p>}
</figure>

<style>
  .cirmap { margin: 0; display: flex; flex-direction: column; gap: var(--spacing-300); }
  .cirmap img { width: 100%; height: auto; }
  .cirmap a:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: 2px; }
  .cirmap__frame { width: 100%; border: 1px solid var(--color-border); }
  .cirmap__caption { color: var(--color-text-secondary); }
  .cirmap p { margin: 0; }
  .cirmap p a { text-decoration: underline; }
</style>
