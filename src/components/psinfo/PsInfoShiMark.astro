---
// PsInfoShiMark — the SHI mark: the Salmon Habitat Indicators icon, alone,
// right of an indicator's name (DELTA-1346, revised at the Phase 9 check-in
// 2026-10-20: the logo plus "Salmon Habitat Indicator" label dominated the
// table). Hover, focus or tap opens a tip naming the program, linked to the
// SHI landing page. One component for every place an indicator is marked:
// indicator table rows and the Indicator Type field of a Complete Indicator
// Report.
//
// The icon is the designer's full-colour icon-only mark (S2), Andy's pick
// 2026-10-20, at 24px. For review, `?icon=2|3` swaps in the teal or purple one.
//
// bcn-lego-checked: the tip is esa-popover in hover mode (hover with delay,
// focus, Escape from anywhere, stays open while the pointer is over the
// panel; the panel sits flush against the trigger so crossing to it never
// leaves the anchor). esa-tooltip holds plain text only, and the tip carries a
// link. The trigger is a native button holding the raster icon:
// esa-button iconOnly and esa-icon-button render a Lucide glyph, not an image.
// psinfo-shi-mark is the reusable home.
import { withBase } from '../../lib/base';
import { SHI_MARK_LABEL } from '../../data/shi-domain';
import { SHI_ICON, SHI_ICON_DEFAULT, shiRoutes } from '../../data/pages/salmon-habitat-indicators';
import { epicMarkAttrs } from '../../data/epics/index';

interface Props {
  /** Jira key of the story that adds this mark here; marks it for the epic preview. */
  epicStory?: string;
}
const { epicStory } = Astro.props;
const epicAttrs = epicStory ? epicMarkAttrs(epicStory, `${SHI_MARK_LABEL} icon`) : {};
const icons = SHI_ICON.map((src) => withBase(src)).join(' ');
---
<esa-popover class="shimark" trigger="hover" position="bottom" has-arrow="false" offset="0" {...epicAttrs}>
  <button class="shimark__btn" type="button" aria-label={SHI_MARK_LABEL}>
    <img class="shimark__icon" src={withBase(SHI_ICON[SHI_ICON_DEFAULT - 1])} data-shi-icons={icons} alt="" width="96" height="96" />
  </button>
  <a slot="content" class="shimark__link" href={withBase(shiRoutes.landing)}>{SHI_MARK_LABEL}</a>
</esa-popover>

<script>
  import '@esa/ecology/esa-popover';

  // Escape from the tip's link: esa-popover hides and hands focus back to the
  // icon, and in hover mode that focus reopens it. Swallow that one focus, so
  // Escape dismisses the tip (SC 1.4.13).
  // Remove once esa-popover ignores the focus its own hide() restores.
  let closing = false;
  // On window, capture: it must run before esa-popover's own document listener.
  window.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    closing = true;
    setTimeout(() => { closing = false; });
  }, true);
  document.querySelectorAll<HTMLButtonElement>('esa-popover.shimark > button').forEach((btn) => {
    btn.addEventListener('focusin', (e) => { if (closing) e.stopPropagation(); });
  });

  // Review switch: ?icon=1|2|3 swaps every SHI icon on the page.
  const pick = Number(new URLSearchParams(location.search).get('icon'));
  if (pick >= 1) {
    document.querySelectorAll<HTMLImageElement>('img[data-shi-icons]').forEach((img) => {
      const src = img.dataset.shiIcons!.split(' ')[pick - 1];
      if (src) img.src = src;
    });
  }
</script>

<style>
  .shimark {
    /* line-height 0 shrinks the host to the button, so middle centres the icon on the name's x-height. */
    line-height: 0;
    vertical-align: middle;
    --popover-max-width: 16rem;
  }
  .shimark__btn {
    display: inline-flex; align-items: center; justify-content: center;
    /* A 24px icon in a 28px target (SC 2.5.8); the negative margin keeps it
       from growing the line it sits on. */
    width: 1.75rem; height: 1.75rem; padding: 0.125rem; margin-block: -0.25rem;
    border: 0; border-radius: 50%;
    background: none; cursor: pointer;
  }
  .shimark__btn:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: 2px; }
  .shimark__icon { display: block; width: 100%; height: 100%; }
  .shimark__link { white-space: nowrap; line-height: 1.5; text-decoration: underline; text-underline-offset: 3px; }
</style>
