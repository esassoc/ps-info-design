---
// PsInfoShiHabitatExplorer — the SHI landing page's habitat picker: a museum
// diorama of salmon habitat from the headwaters to the open Sound (the way the
// fish go), under a life cycle loop whose stages sit over their habitats, with the
// 18 Salmon Habitat Indicators drawn into the scene as landmarks, and the six
// habitat category buttons beneath it. A button or a habitat's region in the
// scene filters the indicator table (psinfo-shi-indicators-grid) to that
// category; selecting it again clears the filter. Each landmark is a link to
// its indicator's page (the same href the table row carries).
//
// The scene is generated art (shi-diorama-art.svg, written by
// docs/private/shi/specimens/e1r7-gen.py along with data/shi-diorama.ts, which
// holds each habitat's traced region and the landmark positions). The art
// keeps its own painted palette; the exhibit chrome (frame, ivory plaques,
// category rings and outlines) comes from theme-shi tokens.
//
// bcn-lego-checked: checked esa-button-toggle / esa-chip-group (segmented
// toggles on the house surface, no per-option category fill) and esa-button
// (no category color hook); the buttons are native <button aria-pressed>
// carrying the --shi-category-* tokens, with a check mark so the pressed
// state is not color alone. No lego renders an illustrated image map; the
// scene is illustration art, so raw hex lives inside the generated SVG only.
// Filter state travels as a `shi:filter` document event so the table needs
// no import. psinfo-shi-habitat-explorer is the reusable home.
import EsaIcon from '@esa/ecology/esa-icon.astro';
import type { HabitatCategory, HabitatCategorySlug } from '../../data/shi-domain';
import { SHI_CATEGORY_FILL, SHI_CATEGORY_ON_FILL } from '../../lib/shiCategoryColor';
import { SHI_GRID_ROWS } from '../../data/pages/salmon-habitat-indicators';
import { withBase } from '../../lib/base';
import {
  SHI_DIORAMA_HEIGHT,
  SHI_DIORAMA_LANDMARKS,
  SHI_DIORAMA_REGIONS,
  SHI_DIORAMA_WIDTH,
} from '../../data/shi-diorama';
import { SHI_LIFECYCLE_STAGES, SHI_LIFECYCLE_SUMMARY } from '../../data/shi-lifecycle';
import art from './shi-diorama-art.svg?raw';

interface Props {
  categories: HabitatCategory[];
  /** The plain list view: the same indicators and links without the graphic. */
  listHref: string;
}
const { categories, listHref } = Astro.props;

const bySlug = Object.fromEntries(categories.map((c) => [c.slug, c])) as Record<string, HabitatCategory>;
const CHECK = '<path d="M20 6 9 17l-5-5"/>';

const catStyle = (slug: HabitatCategorySlug) =>
  `--cat: ${SHI_CATEGORY_FILL[bySlug[slug].colorGroup]}; --cat-on: ${SHI_CATEGORY_ON_FILL[bySlug[slug].colorGroup]}`;

// Buttons sit under the scene in its own order, headwaters to open Sound.
const buttons = SHI_DIORAMA_REGIONS.map((r) => bySlug[r.slug]).filter(Boolean);

const rowBySlug = Object.fromEntries(SHI_GRID_ROWS.map((r) => [r.slug, r]));
const indicatorHref = (h: string) => (/^https?:/.test(h) ? h : withBase(h));
const landmarks = SHI_DIORAMA_LANDMARKS.map((l) => ({ ...l, href: indicatorHref(rowBySlug[l.slug].href) }));
// Life cycle loop: a racetrack over the full scene width. The lower lane runs downstream
// (left to right), the upper lane back upstream; chevrons mark the heading of each lane.
const LC_H = 104, LC_TOP = 34, LC_BOT = 70, LC_R = (LC_BOT - LC_TOP) / 2, LC_L = 40 + LC_R, LC_RT = SHI_DIORAMA_WIDTH - 40 - LC_R;
const lcLoop = `M${LC_L} ${LC_BOT} L${LC_RT} ${LC_BOT} A${LC_R} ${LC_R} 0 0 0 ${LC_RT} ${LC_TOP} L${LC_L} ${LC_TOP} A${LC_R} ${LC_R} 0 0 0 ${LC_L} ${LC_BOT} Z`;
const lcChevrons = [
  ...[230, 508, 836].map((x) => ({ x, y: LC_BOT, dir: 1 })),
  ...[300, 820].map((x) => ({ x, y: LC_TOP, dir: -1 })),
];
const countFor = (slug: HabitatCategorySlug) => SHI_GRID_ROWS.filter((r) => r.category === slug).length;
---
<div class="shix" data-shi-explorer>
  <p class="shix__alt"><a href={withBase(listHref)}>View as a List</a></p>
  <ul class="shix__buttons" role="list">
    {buttons.map((c) => (
      <li>
        <button type="button" class="shix__btn" style={catStyle(c.slug)} aria-pressed="false" data-shi-cat-btn={c.slug}>
          <span class="shix__check"><EsaIcon name="check" size="sm" paths={CHECK} /></span>
          <span>{c.label}</span>
        </button>
      </li>
    ))}
  </ul>

  <div class="shix__strip" role="region" aria-label="Salmon habitat diorama" data-shi-strip>
    <div class="shix__pan">
      <svg class="shix__cycle" viewBox={`0 0 ${SHI_DIORAMA_WIDTH} ${LC_H}`} role="img" aria-label={SHI_LIFECYCLE_SUMMARY}>
        <path class="cycle__loop" d={lcLoop} />
        {lcChevrons.map((c) => (
          <path class="cycle__chev" d={`M${c.x - 5 * c.dir} ${c.y - 6} L${c.x + 4 * c.dir} ${c.y} L${c.x - 5 * c.dir} ${c.y + 6}`} />
        ))}
        {SHI_LIFECYCLE_STAGES.map((st) => {
          const y = st.lane === 'out' ? LC_BOT : LC_TOP;
          return (
            <g transform={`translate(${st.x} ${y})`}>
              <circle class="cycle__node" r="6" />
              <text class="cycle__label" text-anchor="middle" y={st.lane === 'out' ? 28 : -16}>{st.label}</text>
            </g>
          );
        })}
      </svg>
      <div class="shix__frame">
        <svg class="shix__art" viewBox={`0 0 ${SHI_DIORAMA_WIDTH} ${SHI_DIORAMA_HEIGHT}`} width={SHI_DIORAMA_WIDTH} height={SHI_DIORAMA_HEIGHT}>
          <g role="img" aria-labelledby="shix-title shix-desc">
            <title id="shix-title">Salmon habitats from the headwaters to Puget Sound</title>
            <desc id="shix-desc">
              A diorama cross-section from a headwater stream below the Cascades on the left to the open Sound on
              the right, cut away beneath the waterline. Adult chinook, coho and chum spawn over gravel in the
              headwaters among log jams, below a road culvert. Fry with parr marks migrate downstream through
              streams and floodplains and freshwater pools, smolt in the estuary, and enter the Sound past beaches
              with eelgrass meadows and bull kelp. After years in marine water the adults return through the
              estuary and up the river to spawn.
            </desc>
            <Fragment set:html={art} />
          </g>

          <g class="shix__zones">
            {SHI_DIORAMA_REGIONS.map((r) => (
              <g class="zone" data-shi-cat-zone={r.slug} style={catStyle(r.slug)}>
                <path class="zone__halo" d={r.d} />
                <path class="zone__line" d={r.d}><title>{bySlug[r.slug].label}</title></path>
              </g>
            ))}
          </g>

          <g class="shix__exhibits" aria-hidden="true">
            {SHI_DIORAMA_REGIONS.map((r) => (
              <g class="exhibit" data-shi-exhibit={r.slug} style={catStyle(r.slug)}>
                <line class="exhibit__lead" x1={r.pin.x} y1={r.pin.y} x2={r.label.x} y2={r.label.y} />
                <circle class="exhibit__pin" cx={r.pin.x} cy={r.pin.y} r="3" />
                <g transform={`translate(${r.label.x} ${r.label.y})`}>
                  <rect class="exhibit__plaque" rx="2" />
                  <text class="exhibit__text" text-anchor="middle" y="6">
                    <tspan class="exhibit__name">{bySlug[r.slug].label}</tspan>
                    <tspan class="exhibit__count" dx="8">{countFor(r.slug)} indicators</tspan>
                  </text>
                </g>
              </g>
            ))}
          </g>

          <g class="shix__landmarks">
            {landmarks.map((l) => (
              <a class="lm" data-shi-landmark={l.slug} data-shi-cat={l.category} href={l.href} style={catStyle(l.category)}>
                <line class="lm__lead" x1={l.x} y1={l.y} x2={l.plaque.x} y2={l.plaque.y} />
                <g class="lm__label" transform={`translate(${l.plaque.x} ${l.plaque.y})`}>
                  <g class="lm__zoom">
                    <rect class="lm__plaque" rx="2" />
                    <text class="lm__text" text-anchor="middle" y="5">{l.label}</text>
                  </g>
                </g>
                <g class="lm__mark" transform={`translate(${l.x} ${l.y})`}>
                  <g class="lm__zoom">
                    <circle class="lm__focus lm__focus--halo" r="13" />
                    <circle class="lm__focus" r="13" />
                    <circle class="lm__hit" r="14" />
                    <circle class="lm__ring" r="7" />
                    <circle class="lm__dot" r="2.2" />
                  </g>
                </g>
              </a>
            ))}
          </g>
        </svg>
      </div>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-shi-explorer]');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-shi-cat-btn]')];
    const zones = [...root.querySelectorAll<SVGGElement>('[data-shi-cat-zone]')];
    const marks = [...root.querySelectorAll<SVGAElement>('[data-shi-landmark]')];
    const exhibits = [...root.querySelectorAll<SVGGElement>('[data-shi-exhibit]')];
    const scroller = root.querySelector<HTMLElement>('[data-shi-strip]');
    const sceneWidth = root.querySelector<SVGSVGElement>('.shix__art')?.viewBox.baseVal.width ?? 1110;
    let current: string | null = null;
    let hot: string | null = null;
    let touchTap = false;

    const render = () => {
      root.toggleAttribute('data-filtered', current !== null);
      buttons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.shiCatBtn === current));
        b.classList.toggle('is-hover', hot !== null && b.dataset.shiCatBtn === hot);
      });
      zones.forEach((z) => {
        const s = z.dataset.shiCatZone;
        z.classList.toggle('is-selected', s === current);
        z.classList.toggle('is-hover', hot !== null && s === hot && s !== current);
      });
      marks.forEach((m) => {
        const s = m.dataset.shiCat;
        m.classList.toggle('is-selected', s === current);
        m.classList.toggle('is-hover', hot !== null && s === hot);
        m.classList.toggle('is-muted', current !== null && s !== current);
      });
      exhibits.forEach((x) => x.classList.toggle('is-shown', x.dataset.shiExhibit === current));
    };
    const select = (slug: string | null) => {
      current = slug === current ? null : slug;
      render();
      document.dispatchEvent(new CustomEvent('shi:filter', { detail: { category: current, source: 'explorer' } }));
    };
    const hover = (slug: string | null) => {
      if (touchTap || hot === slug) return; // a tap is not a hover: no preview outline sticks to the last thing touched
      hot = slug;
      render();
    };

    buttons.forEach((b) => {
      const slug = b.dataset.shiCatBtn ?? null;
      b.addEventListener('click', () => select(slug));
      b.addEventListener('mouseenter', () => hover(slug));
      b.addEventListener('mouseleave', () => hover(null));
      b.addEventListener('focus', () => hover(slug));
      b.addEventListener('blur', () => hover(null));
    });
    zones.forEach((z) => {
      const slug = z.dataset.shiCatZone ?? null;
      z.addEventListener('click', () => select(slug));
      z.addEventListener('mouseenter', () => hover(slug));
      z.addEventListener('mouseleave', () => hover(null));
    });
    marks.forEach((m) => {
      const slug = m.dataset.shiCat ?? null;
      m.addEventListener('mouseenter', () => hover(slug));
      m.addEventListener('mouseleave', () => hover(null));
      m.addEventListener('focus', () => hover(slug));
      m.addEventListener('blur', () => hover(null));
    });

    // Touch has no hover: the first tap on a medallion opens its label, the second follows the link.
    // A landmark whose habitat is selected already shows its label, so it navigates on the first tap.
    const closeOpen = (except?: Element) => marks.forEach((m) => { if (m !== except) m.classList.remove('is-open'); });
    root.addEventListener('pointerdown', (e) => {
      touchTap = e.pointerType === 'touch';
      if (!(e.target as Element).closest('.lm')) closeOpen();
    }, true);
    marks.forEach((m) => {
      m.addEventListener('click', (e) => {
        if (!touchTap || m.classList.contains('is-open') || m.classList.contains('is-selected')) return;
        e.preventDefault();
        closeOpen(m);
        m.classList.add('is-open');
      });
    });

    // The table's own "clear filters" resets the picker.
    document.addEventListener('shi:filter', (e) => {
      const detail = (e as CustomEvent<{ category: string | null; source: string }>).detail;
      if (detail.source === 'explorer') return;
      current = detail.category;
      render();
    });

    // Plaques size to their text once the fonts are in; a plaque never leaves the frame.
    const fit = (g: SVGGElement, rect: SVGRectElement, text: SVGTextElement, h: number, pad: number) => {
      const w = text.getComputedTextLength() + pad * 2;
      const tr = (g.getAttribute('transform') ?? '').match(/translate\(([-\d.]+) ([-\d.]+)\)/);
      const cx = tr ? parseFloat(tr[1]) : 0;
      const cy = tr ? parseFloat(tr[2]) : 0;
      let shift = 0;
      if (cx - w / 2 < 6) shift = 6 - (cx - w / 2);
      if (cx + w / 2 > sceneWidth - 6) shift = sceneWidth - 6 - (cx + w / 2);
      if (shift) g.setAttribute('transform', `translate(${cx + shift} ${cy})`);
      rect.setAttribute('x', String(-w / 2));
      rect.setAttribute('y', String(-h / 2));
      rect.setAttribute('width', String(w));
      rect.setAttribute('height', String(h));
    };
    const sizePlaques = () => {
      marks.forEach((m) => {
        const g = m.querySelector<SVGGElement>('.lm__label');
        const rect = m.querySelector<SVGRectElement>('.lm__plaque');
        const text = m.querySelector<SVGTextElement>('.lm__text');
        if (g && rect && text) fit(g, rect, text, 24, 9);
      });
      exhibits.forEach((x) => {
        const rect = x.querySelector<SVGRectElement>('.exhibit__plaque');
        const text = x.querySelector<SVGTextElement>('.exhibit__text');
        const g = rect?.parentNode as SVGGElement | null;
        if (g && rect && text) fit(g, rect, text, 32, 12);
      });
    };
    sizePlaques();
    document.fonts?.ready.then(sizePlaques);

    // Wide viewports: the strip bleeds to the window's edges. 100vw counts a classic scrollbar,
    // so its width comes off the bleed or the page would scroll sideways.
    const fitBleed = () => root.style.setProperty('--shix-sbw', `${window.innerWidth - document.documentElement.clientWidth}px`);
    fitBleed();
    window.addEventListener('resize', fitBleed);

    // Narrow viewports: the strip scrolls; the headwaters, where the story starts, sit at its left edge.
    if (scroller) {
      const fitScroller = () => {
        const scrolls = scroller.scrollWidth > scroller.clientWidth + 2;
        if (scrolls) scroller.setAttribute('tabindex', '0');
        else scroller.removeAttribute('tabindex');
        return scrolls;
      };
      fitScroller();
      window.addEventListener('resize', fitScroller);
    }
    render();
  }
</script>

<style>
  .shix { display: flex; flex-direction: column; gap: var(--spacing-400); }
  .shix__alt { order: 0; margin: 0; align-self: flex-end; font-size: var(--ps-info-text-body); }
  .shix__alt a { color: var(--color-text-link); text-decoration: underline; text-underline-offset: 3px; }
  .shix__alt a:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: 2px; }
  /* Magnify on hover (kickoff 2026-10-13): the hovered or focused landmark and
     its plaque scale up in place; transform only, so nothing reflows. */
  .lm__zoom { transform-box: fill-box; transform-origin: center; transition: transform 160ms ease-out; }
  .lm:hover .lm__zoom, .lm:focus-visible .lm__zoom, .lm.is-open .lm__zoom { transform: scale(1.45); }
  @media (prefers-reduced-motion: reduce) { .lm__zoom { transition: none; } }
  .shix__buttons { order: 2; }
  .shix__strip { order: 1; position: relative; }
  .shix__strip:focus-visible { outline: 3px solid var(--focus-ring-color); outline-offset: 4px; }
  .shix__pan { position: relative; width: 100%; }
  .shix__frame {
    position: relative; padding: 7px; border-radius: 3px;
    background: var(--shi-art-frame);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25), 0 10px 28px rgba(5, 31, 51, 0.22);
  }
  .shix__frame::after {
    content: ''; position: absolute; inset: 7px; pointer-events: none;
    border: 1px solid var(--shi-art-frame-line); opacity: 0.55;
  }
  .shix__art { display: block; width: 100%; height: auto; }

  /* Life cycle loop over the scene: navy ink on the page, no category color (stages are not habitats). */
  .shix__cycle { display: block; width: 100%; height: auto; padding: 0 7px; box-sizing: border-box; overflow: visible; }
  .cycle__loop { fill: none; stroke: var(--ps-info-blue-800); stroke-width: 2; stroke-opacity: 0.55; }
  .cycle__chev { fill: none; stroke: var(--ps-info-blue-800); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .cycle__node { fill: var(--ps-info-blue-800); stroke: var(--color-surface); stroke-width: 3; }
  .cycle__label { font-family: var(--font-display); font-size: 16px; font-weight: var(--font-weight-semibold); fill: var(--ps-info-blue-800); }

  /* Wide: the scene and its loop run the full window width; the buttons keep the page column. */
  @media (min-width: 761px) {
    .shix__strip {
      --shix-bleed: calc(100vw - var(--shix-sbw, 0px));
      width: var(--shix-bleed);
      margin-inline: calc((100% - var(--shix-bleed)) / 2);
    }
    .shix__frame { border-radius: 0; }
  }

  /* Habitat regions: the traced shape outlines on hover, outlines and tints when selected. */
  .zone__halo {
    fill: none; stroke: var(--shi-art-ivory); stroke-width: 6; stroke-linejoin: round;
    opacity: 0; pointer-events: none; transition: opacity 160ms ease;
  }
  .zone__line {
    fill: var(--cat); fill-opacity: 0; stroke: var(--cat); stroke-width: 2.6; stroke-linejoin: round; stroke-opacity: 0;
    cursor: pointer; transition: fill-opacity 160ms ease, stroke-opacity 160ms ease;
  }
  .zone.is-hover .zone__halo { opacity: 0.9; stroke-width: 4.5; }
  .zone.is-hover .zone__line { stroke-opacity: 1; stroke-width: 1.8; }
  .zone.is-selected .zone__halo { opacity: 1; stroke-width: 6.5; }
  .zone.is-selected .zone__line { stroke-opacity: 1; stroke-width: 2.8; fill-opacity: 0.16; }

  /* Exhibit label: the selected habitat's name and indicator count, pinned to its region. */
  .exhibit { opacity: 0; pointer-events: none; transition: opacity 160ms ease; }
  .exhibit.is-shown { opacity: 1; }
  .exhibit__lead { stroke: var(--shi-art-ivory); stroke-width: 1.4; }
  .exhibit__pin { fill: var(--cat); stroke: var(--shi-art-ivory); stroke-width: 1.5; }
  .exhibit__plaque { fill: var(--shi-art-ivory); stroke: var(--cat); stroke-width: 2; }
  .exhibit__text { fill: var(--shi-art-ivory-ink); }
  .exhibit__name { font-family: var(--font-display); font-size: 16px; font-weight: var(--font-weight-semibold); }
  .exhibit__count { font-family: var(--font-sans); font-size: 15px; font-weight: var(--font-weight-regular); }

  /* Landmarks: a medallion ringed in the habitat's color, its name on an ivory plaque, a leader between.
     a11y-checked: the keyboard focus ring is drawn, not suppressed. .lm:focus-visible lights the two
     .lm__focus circles (an ivory halo under a navy ring) around the medallion, which reads on sky, water
     and earth; the browser's default rectangle would wrap the whole link (plaque, leader and medallion)
     and vanish against the dark water. The ring also grows and the plaque takes the category edge. */
  .lm { transition: opacity 160ms ease; }
  .lm:focus-visible { outline: none; }
  .lm:focus:not(:focus-visible) { outline: none; } /* a11y-checked: pointer and touch focus only; keyboard focus keeps the drawn ring above */
  /* Labels stay hidden at rest, so the scene reads as eighteen medallions. A plaque and its leader appear for
     the landmark under the pointer or keyboard focus, for every landmark of the selected habitat, and for a
     landmark opened by a first tap on touch. The text is hidden visually only, so each link keeps its name.
     A hidden plaque or leader is not a hit target; only the medallion wakes it. */
  .lm__lead { stroke: var(--shi-art-ivory); stroke-width: 1.2; opacity: 0; pointer-events: none; transition: opacity 160ms ease; }
  .lm__label { opacity: 0; pointer-events: none; transition: opacity 160ms ease; }
  .lm__plaque { fill: var(--shi-art-ivory); stroke: var(--shi-art-ivory-ink); stroke-opacity: 0.45; stroke-width: 1; }
  .lm__text { font-family: var(--font-display); font-size: 14px; font-weight: var(--font-weight-medium); fill: var(--shi-art-ivory-ink); }
  .lm__hit { fill: transparent; }
  .lm__ring { fill: var(--shi-art-ivory); stroke: var(--cat); stroke-width: 2.4; transition: r 160ms ease, stroke-width 160ms ease; }
  .lm__dot { fill: var(--cat); }
  .lm__focus { fill: none; stroke: var(--shi-art-ivory-ink); stroke-width: 2.5; opacity: 0; }
  .lm__focus--halo { stroke: var(--shi-art-ivory); stroke-width: 6.5; }
  .lm:focus-visible .lm__focus { opacity: 1; }
  .lm:hover .lm__lead, .lm:focus-visible .lm__lead, .lm.is-selected .lm__lead, .lm.is-open .lm__lead { opacity: 0.9; }
  .lm:hover .lm__label, .lm:focus-visible .lm__label, .lm.is-selected .lm__label, .lm.is-open .lm__label { opacity: 1; pointer-events: auto; }
  .lm:hover .lm__ring, .lm:focus-visible .lm__ring, .lm.is-selected .lm__ring, .lm.is-open .lm__ring { r: 9; stroke-width: 3; }
  .lm:hover .lm__plaque, .lm:focus-visible .lm__plaque, .lm.is-selected .lm__plaque, .lm.is-open .lm__plaque { stroke: var(--cat); stroke-opacity: 1; stroke-width: 2; }
  .lm:hover .lm__text, .lm:focus-visible .lm__text, .lm.is-selected .lm__text, .lm.is-open .lm__text { font-weight: var(--font-weight-semibold); }
  /* Landmarks of the other habitats go quiet structurally while one is selected: a smaller, gray-ringed
     medallion. The ink and the ivory are untouched, so an opened label keeps its full contrast. */
  .lm.is-muted .lm__ring { r: 5.5; stroke: var(--shi-art-ivory-ink); stroke-opacity: 0.45; stroke-width: 1.6; }
  .lm.is-muted .lm__dot { opacity: 0; }
  .lm.is-muted:hover .lm__ring, .lm.is-muted:focus-visible .lm__ring, .lm.is-muted.is-open .lm__ring { r: 9; stroke: var(--cat); stroke-opacity: 1; stroke-width: 3; }
  .lm.is-muted:hover .lm__dot, .lm.is-muted:focus-visible .lm__dot, .lm.is-muted.is-open .lm__dot { opacity: 1; }

  /* Habitat buttons, one per region in scene order. */
  .shix__buttons {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--spacing-200);
  }
  .shix__buttons li { display: flex; }
  .shix__btn {
    position: relative; flex: 1; min-height: 3.5rem;
    display: flex; align-items: center; justify-content: center;
    /* Equal side padding reserves the pressed check's corner on both sides, so the label stays
       centered and the check never sits over it, down to the two-column layout at 390px. */
    padding: var(--spacing-200) 2.25rem;
    background: var(--cat); color: var(--cat-on);
    font-size: 1rem; font-weight: var(--font-weight-semibold); line-height: 1.25;
    text-align: center;
    border: 3px solid transparent;
