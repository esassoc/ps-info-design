---
// PsInfoShiHabitatExplorer — the SHI landing page's habitat picker, per the
// deck: the salmon life-cycle graphic flanked by the six habitat category
// buttons. A button or a habitat zone in the graphic filters the indicator
// table (psinfo-shi-indicators-grid) to that category; selecting it again
// clears the filter.
//
// The graphic is drawn here, not the deck's watercolor (third-party art):
// a watershed-to-sea transect split into the six habitat zones, with the four
// life-cycle stages as arrows. Zones are pointer targets only; the buttons are
// the keyboard and screen-reader controls (same action, so nothing is
// mouse-only), and the svg is a single described image.
//
// bcn-lego-checked: checked esa-button-toggle / esa-chip-group (segmented
// toggles on the house surface, no per-option category fill) and esa-button
// (no category color hook); the buttons are native <button aria-pressed>
// carrying the --shi-category-* tokens, with a check mark so the pressed
// state is not color alone. No lego renders an image map. Filter state
// travels as a `shi:filter` document event so the table needs no import.
// psinfo-shi-habitat-explorer is the reusable home.
import EsaIcon from '@esa/ecology/esa-icon.astro';
import type { HabitatCategory } from '../../data/shi-domain';
import { SHI_CATEGORY_FILL, SHI_CATEGORY_ON_FILL } from '../../lib/shiCategoryColor';

interface Props {
  categories: HabitatCategory[];
}
const { categories } = Astro.props;

const left = categories.slice(0, 3);
const right = categories.slice(3);
const bySlug = Object.fromEntries(categories.map((c) => [c.slug, c]));

const CHECK = '<path d="M20 6 9 17l-5-5"/>';

// Transect zones, left (open water) to right (headwaters). Polygons share
// edges; the top edge is the water surface or the land profile.
const ZONES: { slug: string; d: string }[] = [
  { slug: 'marine-water', d: 'M0 200 L250 200 L250 440 L0 440 Z' },
  { slug: 'beaches-marine-vegetation', d: 'M250 200 L330 200 L370 192 L370 440 L250 440 Z' },
  { slug: 'estuaries', d: 'M370 192 L490 186 L490 440 L370 440 Z' },
  { slug: 'streams-floodplains', d: 'M490 186 L570 178 L650 160 L650 440 L490 440 Z' },
  { slug: 'freshwater', d: 'M650 160 L720 142 L790 120 L790 440 L650 440 Z' },
  { slug: 'stream-structure', d: 'M790 120 L860 96 L900 80 L960 70 L960 440 L790 440 Z' },
];

const button = (c: HabitatCategory) => ({
  slug: c.slug,
  label: c.label,
  style: `--cat: ${SHI_CATEGORY_FILL[c.colorGroup]}; --cat-on: ${SHI_CATEGORY_ON_FILL[c.colorGroup]}`,
});
---
<div class="shix" data-shi-explorer>
  <ul class="shix__col shix__col--left" role="list">
    {left.map(button).map((b) => (
      <li>
        <button type="button" class="shix__btn" style={b.style} aria-pressed="false" data-shi-cat-btn={b.slug}>
          <span class="shix__check"><EsaIcon name="check" size="sm" paths={CHECK} /></span>
          <span>{b.label}</span>
        </button>
      </li>
    ))}
  </ul>

  <figure class="shix__figure">
    <svg class="shix__art" viewBox="0 0 960 440" role="img" aria-labelledby="shix-title shix-desc">
      <title id="shix-title">Salmon habitat use throughout the life cycle</title>
      <desc id="shix-desc">
        A transect from open marine water to mountain headwaters, divided into six habitat zones: marine water,
        beaches and marine vegetation, estuaries, streams and floodplains, freshwater, and stream structure.
        Arrows trace the life cycle: 1, fry migrate downstream; 2, juveniles enter the ocean through estuaries
        and nearshore waters; 3, adults return and enter rivers; 4, adults spawn in the headwaters.
      </desc>
      <defs>
        <marker id="shix-arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M0 0 L10 5 L0 10 Z" class="shix__arrowhead" />
        </marker>
      </defs>

      <g class="shix__scene" aria-hidden="true">
        <path class="shix__mountain" d="M630 164 L720 66 L770 104 L850 34 L920 70 L960 52 L960 72 L900 80 L860 96 L790 120 L720 142 L650 160 Z" />
        <path class="shix__ground" d="M0 420 C120 404 220 352 300 262 L330 200 L370 192 L490 186 L570 178 L650 160 L720 142 L790 120 L860 96 L900 80 L960 70 L960 440 L0 440 Z" />
        <path class="shix__waves" d="M0 200 q20 -7 40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0" />
        <path class="shix__river" d="M952 76 C910 86 880 98 840 106 S760 130 720 146 S660 164 620 168 C590 172 566 168 544 180 C520 192 470 186 440 192 C410 197 392 196 372 196" />
        <ellipse class="shix__lake" cx="716" cy="150" rx="34" ry="5" />
        <g class="shix__wood">
          <rect x="866" y="84" width="34" height="6" rx="3" transform="rotate(-18 883 87)" />
          <rect x="818" y="100" width="30" height="6" rx="3" transform="rotate(12 833 103)" />
        </g>
        <g class="shix__veg">
          <path d="M268 306 q-6 -18 2 -38 M282 290 q-6 -18 2 -38 M296 274 q-6 -18 2 -38 M310 256 q-6 -18 2 -36 M324 236 q-5 -14 2 -28" />
          <path d="M392 190 l4 -12 l4 12 M424 188 l4 -12 l4 12 M456 187 l4 -12 l4 12" />
          <path d="M392 204 C410 214 430 214 446 226 M418 212 C426 222 424 232 432 240" class="shix__channel" />
          <path d="M520 182 l8 -22 l8 22 Z M600 172 l8 -22 l8 22 Z M676 154 l8 -22 l8 22 Z" class="shix__tree" />
        </g>
        <g class="shix__fish">
          <path d="M110 312 c12 -8 28 -8 40 0 c-12 8 -28 8 -40 0 Z M150 312 l10 -7 v14 Z" />
          <path d="M190 262 c9 -6 21 -6 30 0 c-9 6 -21 6 -30 0 Z M220 262 l8 -5 v10 Z" />
        </g>
      </g>

      <g class="shix__zones">
        {ZONES.map((z) => (
          <path
            class="shix__zone"
            d={z.d}
            data-shi-cat-zone={z.slug}
            style={`--cat: ${SHI_CATEGORY_FILL[bySlug[z.slug].colorGroup]}`}
          >
            <title>{bySlug[z.slug].label}</title>
          </path>
        ))}
      </g>

      <g class="shix__cycle" aria-hidden="true">
        <path d="M140 190 C220 30 600 10 868 62" marker-end="url(#shix-arrow)" />
        <path d="M832 140 C760 196 640 220 520 226" marker-end="url(#shix-arrow)" />
        <path d="M468 252 C400 282 300 300 176 300" marker-end="url(#shix-arrow)" />
        <text x="292" y="68">3. River Entry</text>
        <text x="806" y="190">4. Spawning</text>
        <text x="560" y="262">1. Fry Migration</text>
        <text x="256" y="344">2. Ocean Entry</text>
      </g>
    </svg>
  </figure>

  <ul class="shix__col shix__col--right" role="list">
    {right.map(button).map((b) => (
      <li>
        <button type="button" class="shix__btn" style={b.style} aria-pressed="false" data-shi-cat-btn={b.slug}>
          <span class="shix__check"><EsaIcon name="check" size="sm" paths={CHECK} /></span>
          <span>{b.label}</span>
        </button>
      </li>
    ))}
  </ul>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-shi-explorer]');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-shi-cat-btn]')];
    const zones = [...root.querySelectorAll<SVGPathElement>('[data-shi-cat-zone]')];
    let current: string | null = null;

    const render = () => {
      root.toggleAttribute('data-filtered', current !== null);
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.shiCatBtn === current)));
      zones.forEach((z) => z.classList.toggle('is-selected', z.dataset.shiCatZone === current));
    };
    const select = (slug: string | null) => {
      current = slug === current ? null : slug;
      render();
      document.dispatchEvent(new CustomEvent('shi:filter', { detail: { category: current, source: 'explorer' } }));
    };
    const hover = (slug: string | null) => {
      buttons.forEach((b) => b.classList.toggle('is-hover', b.dataset.shiCatBtn === slug));
      zones.forEach((z) => z.classList.toggle('is-hover', z.dataset.shiCatZone === slug));
    };

    buttons.forEach((b) => {
      b.addEventListener('click', () => select(b.dataset.shiCatBtn ?? null));
      b.addEventListener('mouseenter', () => hover(b.dataset.shiCatBtn ?? null));
      b.addEventListener('mouseleave', () => hover(null));
    });
    zones.forEach((z) => {
      z.addEventListener('click', () => select(z.dataset.shiCatZone ?? null));
      z.addEventListener('mouseenter', () => hover(z.dataset.shiCatZone ?? null));
      z.addEventListener('mouseleave', () => hover(null));
    });

    // The table's own "clear filters" resets the picker.
    document.addEventListener('shi:filter', (e) => {
      const detail = (e as CustomEvent<{ category: string | null; source: string }>).detail;
      if (detail.source === 'explorer') return;
      current = detail.category;
      render();
    });
  }
</script>

<style>
  .shix {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) minmax(0, 1fr) minmax(9rem, 12rem);
    grid-template-areas: 'left art right';
    align-items: center;
    gap: var(--spacing-500);
  }
  .shix__col--left { grid-area: left; }
  .shix__col--right { grid-area: right; }
  .shix__figure { grid-area: art; margin: 0; }

  .shix__col {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: var(--spacing-400);
  }
  .shix__btn {
    position: relative;
    width: 100%; min-height: 5.5rem;
    display: flex; align-items: center; justify-content: center;
    padding: var(--spacing-300) var(--spacing-400);
    background: var(--cat); color: var(--cat-on);
    font-size: 1.0625rem; font-weight: var(--font-weight-semibold); line-height: 1.3;
    text-align: center;
    border: 3px solid transparent;
    border-radius: var(--radius-100);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }
  .shix__btn:hover, .shix__btn.is-hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(5, 31, 51, 0.22); }
  .shix__btn:focus-visible { outline: 3px solid var(--focus-ring-color); outline-offset: 3px; }
  .shix__btn[aria-pressed='true'] {
    border-color: var(--ps-info-gray-950);
    box-shadow: inset 0 0 0 2px #ffffff;
  }
  .shix__check {
    position: absolute; top: var(--spacing-150); right: var(--spacing-150);
    display: none;
    width: 1.5rem; height: 1.5rem; border-radius: 999px;
    align-items: center; justify-content: center;
    background: #ffffff; color: var(--ps-info-gray-950);
  }
  .shix__btn[aria-pressed='true'] .shix__check { display: inline-flex; }

  .shix__art { display: block; width: 100%; height: auto; }

  .shix__mountain { fill: var(--shi-art-mountain); }
  .shix__ground { fill: var(--shi-art-ground); }
  .shix__waves { fill: none; stroke: var(--shi-art-water); stroke-width: 3; }
  .shix__river { fill: none; stroke: var(--shi-art-river); stroke-width: 6; stroke-linecap: round; }
  .shix__lake { fill: var(--shi-art-river); }
  .shix__wood rect { fill: var(--shi-art-wood); }
  .shix__veg path { fill: none; stroke: var(--shi-art-vegetation); stroke-width: 3; stroke-linecap: round; }
  .shix__veg .shix__channel { stroke: var(--shi-art-river); stroke-width: 3; }
  .shix__veg .shix__tree { fill: var(--shi-art-vegetation); stroke: none; }
  .shix__fish path { fill: var(--shi-art-fish); }

  .shix__zone {
    fill: var(--cat); fill-opacity: 0.2;
    stroke: #ffffff; stroke-width: 2;
    cursor: pointer;
    transition: fill-opacity 120ms ease;
  }
  .shix__zone:hover, .shix__zone.is-hover { fill-opacity: 0.36; }
  [data-filtered] .shix__zone { fill-opacity: 0.08; }
  [data-filtered] .shix__zone:hover, [data-filtered] .shix__zone.is-hover { fill-opacity: 0.24; }
  .shix__zone.is-selected, [data-filtered] .shix__zone.is-selected { fill-opacity: 0.48; }

  .shix__cycle { pointer-events: none; }
  .shix__cycle path { fill: none; stroke: var(--shi-art-arrow); stroke-width: 4; stroke-linecap: round; }
  .shix__arrowhead { fill: var(--shi-art-arrow); }
  .shix__cycle text {
    font-family: var(--font-sans); font-size: 24px; font-weight: var(--font-weight-bold);
    fill: var(--shi-art-arrow);
    paint-order: stroke; stroke: #ffffff; stroke-width: 6px; stroke-linejoin: round;
  }

  @media (max-width: 860px) {
    .shix {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: 'art art' 'left right';
      gap: var(--spacing-400);
    }
    .shix__btn { min-height: 4rem; }
    .shix__cycle text { font-size: 30px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .shix__btn:hover, .shix__btn.is-hover { transform: none; }
  }
</style>
