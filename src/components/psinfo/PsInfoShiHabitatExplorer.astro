---
// PsInfoShiHabitatExplorer — the SHI landing page's habitat picker: a museum
// diorama of salmon habitat from the headwaters to the open Sound (the way the
// fish go), under a life cycle loop whose stages sit over their habitats, with the
// 18 Salmon Habitat Indicators drawn into the scene as landmarks, and the six
// habitat category buttons beneath it. A button or a habitat's region in the
// scene filters the indicator table (psinfo-shi-indicators-grid) to that
// category; selecting it again clears the filter. Each landmark is a link to
// its indicator's page (the same href the table row carries).
//
// The scene is generated art (shi-diorama-art.svg, written by
// docs/private/shi/specimens/e1r7-gen.py along with data/shi-diorama.ts, which
// holds each habitat's traced region and the landmark positions). The art
// keeps its own painted palette; the exhibit chrome (frame, ivory plaques,
// category rings and outlines) comes from theme-shi tokens.
//
// bcn-lego-checked: checked esa-button-toggle / esa-chip-group (segmented
// toggles on the house surface, no per-option category fill) and esa-button
// (no category color hook); the buttons are native <button aria-pressed>
// carrying the --shi-category-* tokens, with a check mark so the pressed
// state is not color alone. No lego renders an illustrated image map; the
// scene is illustration art, so raw hex lives inside the generated SVG only.
// Filter state travels as a `shi:filter` document event so the table needs
// no import. psinfo-shi-habitat-explorer is the reusable home.
import EsaIcon from '@esa/ecology/esa-icon.astro';
import type { HabitatCategory, HabitatCategorySlug } from '../../data/shi-domain';
import { SHI_CATEGORY_FILL, SHI_CATEGORY_ON_FILL } from '../../lib/shiCategoryColor';
import { SHI_GRID_ROWS } from '../../data/pages/salmon-habitat-indicators';
import { withBase } from '../../lib/base';
import {
  SHI_DIORAMA_HEIGHT,
  SHI_DIORAMA_LANDMARKS,
  SHI_DIORAMA_REGIONS,
  SHI_DIORAMA_WIDTH,
} from '../../data/shi-diorama';
import { SHI_BASIN_CYCLE, SHI_BASIN_HEIGHT, SHI_BASIN_LANDMARKS, SHI_BASIN_REGIONS, SHI_BASIN_WIDTH } from '../../data/shi-basin';
import type { SceneCycle } from '../../data/shi-basin';
import { SHI_LIFECYCLE_STAGES, SHI_LIFECYCLE_SUMMARY } from '../../data/shi-lifecycle';
import dioramaArt from './shi-diorama-art.svg?raw';
import basinArt from './shi-basin-art.svg?raw';

interface Props {
  categories: HabitatCategory[];
  /** 'diorama': the flat museum cross-section; 'basin': the river basin as a tilted tabletop map. */
  scene?: 'diorama' | 'basin';
}
const { categories, scene = 'diorama' } = Astro.props;

// A scene with its own `cycle` draws the life cycle as a route on the map; one without gets the
// racetrack over its sky.
const SCENES: Record<'diorama' | 'basin', { width: number; height: number; regions: typeof SHI_DIORAMA_REGIONS; landmarks: typeof SHI_DIORAMA_LANDMARKS; art: string; cycle?: SceneCycle }> = {
  diorama: { width: SHI_DIORAMA_WIDTH, height: SHI_DIORAMA_HEIGHT, regions: SHI_DIORAMA_REGIONS, landmarks: SHI_DIORAMA_LANDMARKS, art: dioramaArt },
  basin: { width: SHI_BASIN_WIDTH, height: SHI_BASIN_HEIGHT, regions: SHI_BASIN_REGIONS, landmarks: SHI_BASIN_LANDMARKS, art: basinArt, cycle: SHI_BASIN_CYCLE },
};
const SCENE_DESC = {
  diorama:
    'A diorama cross-section from a headwater stream below the Cascades on the left to the open Sound on the right, ' +
    'cut away beneath the waterline. Adult chinook, coho and chum spawn over gravel in the headwaters among log jams, ' +
    'below a road culvert. Fry with parr marks migrate downstream through streams and floodplains and freshwater pools, ' +
    'smolt in the estuary, and enter the Sound past beaches with eelgrass meadows and bull kelp. After years in marine ' +
    'water the adults return through the estuary and up the river to spawn.',
  basin:
    'A map of one river basin laid out like a tabletop, the Cascades behind it. Headwater streams run out of ' +
    'the conifer forest at the back, past a gravel bar and a log jam where adults spawn, and a tributary with a ' +
    'temperature logger joins them. The river winds through a floodplain valley with an oxbow lake, a side channel, ' +
    'flow gauges, alders along its banks and a flooded pasture, then braids through a delta marsh to the beach. A ' +
    'feeder bluff with forest on top stands on the left shore and a pocket estuary sits behind a spit on the right. ' +
    'Eelgrass and kelp grow in the shallows; the Sound along the front is cut away to show the water column, with ' +
    'a buoy and a moored sensor. The life cycle route runs down the river, out into the Sound and back up to spawn.',
};
const { width: SCENE_W, height: SCENE_H, regions: REGIONS, landmarks: LANDMARKS, art, cycle: ROUTE } = SCENES[scene];

const bySlug = Object.fromEntries(categories.map((c) => [c.slug, c])) as Record<string, HabitatCategory>;
const CHECK = '<path d="M20 6 9 17l-5-5"/>';

const catStyle = (slug: HabitatCategorySlug) =>
  `--cat: ${SHI_CATEGORY_FILL[bySlug[slug].colorGroup]}; --cat-on: ${SHI_CATEGORY_ON_FILL[bySlug[slug].colorGroup]}`;

// Buttons sit under the scene in its own order, headwaters to open Sound.
const buttons = REGIONS.map((r) => bySlug[r.slug]).filter(Boolean);

const rowBySlug = Object.fromEntries(SHI_GRID_ROWS.map((r) => [r.slug, r]));
const indicatorHref = (h: string) => (/^https?:/.test(h) ? h : withBase(h));
const landmarks = LANDMARKS.map((l) => ({ ...l, href: indicatorHref(rowBySlug[l.slug].href) }));
// Life cycle loop: a slim racetrack laid over the scene's sky in white. The lower lane runs
// downstream (left to right), the upper lane back upstream; chevrons mark each lane's heading,
// and a fish swims the loop (psinfo-shi-habitat-explorer's script keeps it upright).
const LC_TOP = 26, LC_BOT = 50, LC_R = (LC_BOT - LC_TOP) / 2, LC_L = 40 + LC_R, LC_RT = SCENE_W - 40 - LC_R;
const lcLoop = `M${LC_L} ${LC_BOT} L${LC_RT} ${LC_BOT} A${LC_R} ${LC_R} 0 0 0 ${LC_RT} ${LC_TOP} L${LC_L} ${LC_TOP} A${LC_R} ${LC_R} 0 0 0 ${LC_L} ${LC_BOT} Z`;
// A stage sits over the middle of its habitat's region (the horizontal extent of its traced shape).
const regionX = Object.fromEntries(
  REGIONS.map((r) => {
    const xs = [...r.d.matchAll(/[ML]?\s*(-?[\d.]+)[ ,](-?[\d.]+)/g)].map((m) => parseFloat(m[1]));
    return [r.slug, (Math.min(...xs) + Math.max(...xs)) / 2];
  }),
);
const lcStages = SHI_LIFECYCLE_STAGES.map((st) => ({ ...st, x: st.lane === 'out' ? regionX[st.habitat] : SCENE_W / 2 }));
const outX = lcStages.filter((st) => st.lane === 'out').map((st) => st.x).sort((a, b) => a - b);
const lcChevrons = [
  ...outX.slice(1).map((x, k) => ({ x: (x + outX[k]) / 2, y: LC_BOT, dir: 1 })),
  ...[0.27, 0.73].map((t) => ({ x: SCENE_W * t, y: LC_TOP, dir: -1 })),
];
const countFor = (slug: HabitatCategorySlug) => SHI_GRID_ROWS.filter((r) => r.category === slug).length;
---
<div class="shix" data-shi-explorer data-scene={scene} style={`--shix-scene-w: ${SCENE_W}px`}>
  <ul class="shix__buttons" role="list">
    {buttons.map((c) => (
      <li>
        <button type="button" class="shix__btn" style={catStyle(c.slug)} aria-pressed="false" data-shi-cat-btn={c.slug}>
          <span class="shix__check"><EsaIcon name="check" size="sm" paths={CHECK} /></span>
          <span>{c.label}</span>
        </button>
      </li>
    ))}
  </ul>

  <div class="shix__strip" role="region" aria-label="Salmon habitat diorama" data-shi-strip>
    <div class="shix__pan">
      <div class="shix__frame">
        <svg class="shix__art" viewBox={`0 0 ${SCENE_W} ${SCENE_H}`} width={SCENE_W} height={SCENE_H}>
          <g role="img" aria-labelledby="shix-title shix-desc">
            <title id="shix-title">Salmon habitats from the headwaters to Puget Sound</title>
            <desc id="shix-desc">{SCENE_DESC[scene]}</desc>
            <Fragment set:html={art} />
          </g>

          <g class="shix__cycle" role="img" aria-label={SHI_LIFECYCLE_SUMMARY}>
            {ROUTE ? (
              <>
                <path class="cycle__halo" d={ROUTE.d} />
                <path class="cycle__loop cycle__loop--route" d={ROUTE.d} data-shi-cycle-path data-shi-cycle-nodes={JSON.stringify(ROUTE.nodes.map((n) => [n.x, n.y]))} />
                <path class="cycle__flow" d={ROUTE.d} data-shi-cycle-flow />
                {[60, 34, 16].map((len) => (
                  <path class="cycle__wake" d={ROUTE.d} data-shi-cycle-wake={len} />
                ))}
                {ROUTE.nodes.map((n, k) => (
                  <g transform={`translate(${n.x} ${n.y})`}>
                    <circle class="cycle__node" r="4" />
                    <text class="cycle__label" text-anchor={n.label.anchor} x={n.label.dx} y={n.label.dy}>{SHI_LIFECYCLE_STAGES[k].label}</text>
                  </g>
                ))}
              </>
            ) : (
              <>
                <path class="cycle__loop" d={lcLoop} data-shi-cycle-path />
                {lcChevrons.map((c) => (
                  <path class="cycle__chev" d={`M${c.x - 4 * c.dir} ${c.y - 5} L${c.x + 3 * c.dir} ${c.y} L${c.x - 4 * c.dir} ${c.y + 5}`} />
                ))}
                {lcStages.map((st) => {
                  const y = st.lane === 'out' ? LC_BOT : LC_TOP;
                  return (
                    <g transform={`translate(${st.x} ${y})`}>
                      <circle class="cycle__node" r="4" />
                      <text class="cycle__label" text-anchor="middle" y={st.lane === 'out' ? 22 : -11}>{st.label}</text>
                    </g>
                  );
                })}
              </>
            )}
            <g class="cycle__fish" data-shi-cycle-fish data-stage="smolt" aria-hidden="true">
              <g class="cycle__size">
                <g class="cycle__tail" data-shi-fish-tail>
                  <path class="cycle__fin" d="M-9.5 0 C-11 -1 -12.5 -3 -14.6 -5.2 C-14 -2.6 -13.6 -1 -13.4 0 C-13.6 1 -14 2.6 -14.6 5.2 C-12.5 3 -11 1 -9.5 0 Z" />
                </g>
                <path class="cycle__fin" d="M1 -3.7 C0 -4.7 -1.6 -5 -3.2 -4.8 C-2.8 -4.3 -2.6 -3.9 -2.6 -3.4 Z" />
                <path class="cycle__fin" d="M-6 -2.5 L-7.3 -4 L-7.8 -2.2 Z" />
                <path class="cycle__body" d="M12.6 0.2 C11.2 -1.6 8.6 -3.4 4.6 -3.8 C0.6 -4.2 -4.8 -3 -8.4 -1.3 C-9.4 -0.8 -10 -0.3 -10.2 0 C-10 0.4 -9.4 0.9 -8.4 1.4 C-4.8 3 0.6 4 4.6 3.7 C8.4 3.3 11.2 1.8 12.6 0.2 Z" />
                <path class="cycle__back" d="M12.4 -0.1 C11 -1.7 8.4 -3.4 4.6 -3.8 C0.6 -4.2 -4.8 -3 -8.4 -1.3 C-9.4 -0.8 -10 -0.3 -10.2 0 C-6 -0.6 -1 -1.2 4 -1 C7 -0.9 10 -0.5 12.4 -0.1 Z" />
                <g class="cycle__marks">
                  <ellipse cx="-4.5" cy="0.2" rx="1" ry="1.9" /><ellipse cx="-1" cy="0.1" rx="1.1" ry="2.1" /><ellipse cx="2.6" cy="0" rx="1.1" ry="2" /><ellipse cx="6" cy="0" rx="0.9" ry="1.6" />
                </g>
                <g class="cycle__spots">
                  <circle cx="-7" cy="-1.4" r=".45" /><circle cx="-4.6" cy="-2.2" r=".45" /><circle cx="-2" cy="-2.6" r=".45" /><circle cx="0.8" cy="-2.7" r=".45" /><circle cx="-5.8" cy="-0.4" r=".4" /><circle cx="-3" cy="-1.1" r=".4" />
                </g>
                <path class="cycle__pec" d="M5.6 1.8 C4.2 3.4 2.6 4.2 1.4 4.3 C2.4 3.2 3.4 2.4 4.2 1.7 Z" />
                <circle class="cycle__eye" cx="8.4" cy="-0.6" r=".85" />
              </g>
            </g>
          </g>

          <g class="shix__zones">
            {REGIONS.map((r) => (
              <g class="zone" data-shi-cat-zone={r.slug} style={catStyle(r.slug)}>
                <path class="zone__halo" d={r.d} />
                <path class="zone__line" d={r.d}><title>{bySlug[r.slug].label}</title></path>
              </g>
            ))}
          </g>

          <g class="shix__exhibits" aria-hidden="true">
            {REGIONS.map((r) => (
              <g class="exhibit" data-shi-exhibit={r.slug} style={catStyle(r.slug)}>
                <line class="exhibit__lead" x1={r.pin.x} y1={r.pin.y} x2={r.label.x} y2={r.label.y} />
                <circle class="exhibit__pin" cx={r.pin.x} cy={r.pin.y} r="3" />
                <g transform={`translate(${r.label.x} ${r.label.y})`}>
                  <rect class="exhibit__plaque" rx="2" />
                  <text class="exhibit__text" text-anchor="middle" y="6">
                    <tspan class="exhibit__name">{bySlug[r.slug].label}</tspan>
                    <tspan class="exhibit__count" dx="8">{countFor(r.slug)} {countFor(r.slug) === 1 ? 'indicator' : 'indicators'}</tspan>
                  </text>
                </g>
              </g>
            ))}
          </g>

          <g class="shix__landmarks">
            {landmarks.map((l) => (
              <a class="lm" data-shi-landmark={l.slug} data-shi-cat={l.category} href={l.href} style={catStyle(l.category)}>
                <line class="lm__lead" x1={l.x} y1={l.y} x2={l.plaque.x} y2={l.plaque.y} />
                <g class="lm__label" transform={`translate(${l.plaque.x} ${l.plaque.y})`}>
                  <g class="lm__zoom">
                    <rect class="lm__plaque" rx="2" />
                    <text class="lm__text" text-anchor="middle" y="5">{l.label}</text>
                  </g>
                </g>
                <g class="lm__mark" transform={`translate(${l.x} ${l.y})`}>
                  <g class="lm__zoom">
                    <circle class="lm__focus lm__focus--halo" r="13" />
                    <circle class="lm__focus" r="13" />
                    <circle class="lm__hit" r="14" />
                    <circle class="lm__ring" r="7" />
                    <circle class="lm__dot" r="2.2" />
                  </g>
                </g>
              </a>
            ))}
          </g>
        </svg>
      </div>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-shi-explorer]');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-shi-cat-btn]')];
    const zones = [...root.querySelectorAll<SVGGElement>('[data-shi-cat-zone]')];
    const marks = [...root.querySelectorAll<SVGAElement>('[data-shi-landmark]')];
    const exhibits = [...root.querySelectorAll<SVGGElement>('[data-shi-exhibit]')];
    const scroller = root.querySelector<HTMLElement>('[data-shi-strip]');
    const sceneWidth = root.querySelector<SVGSVGElement>('.shix__art')?.viewBox.baseVal.width ?? 1110;
    let current: string | null = null;
    let hot: string | null = null;
    let touchTap = false;

    const render = () => {
      root.toggleAttribute('data-filtered', current !== null);
      buttons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.shiCatBtn === current));
        b.classList.toggle('is-hover', hot !== null && b.dataset.shiCatBtn === hot);
      });
      zones.forEach((z) => {
        const s = z.dataset.shiCatZone;
        z.classList.toggle('is-selected', s === current);
        z.classList.toggle('is-hover', hot !== null && s === hot && s !== current);
      });
      marks.forEach((m) => {
        const s = m.dataset.shiCat;
        m.classList.toggle('is-selected', s === current);
        m.classList.toggle('is-hover', hot !== null && s === hot);
        m.classList.toggle('is-muted', current !== null && s !== current);
      });
      exhibits.forEach((x) => x.classList.toggle('is-shown', x.dataset.shiExhibit === current));
    };
    const select = (slug: string | null) => {
      current = slug === current ? null : slug;
      render();
      document.dispatchEvent(new CustomEvent('shi:filter', { detail: { category: current, source: 'explorer' } }));
    };
    const hover = (slug: string | null) => {
      if (touchTap || hot === slug) return; // a tap is not a hover: no preview outline sticks to the last thing touched
      hot = slug;
      render();
    };

    buttons.forEach((b) => {
      const slug = b.dataset.shiCatBtn ?? null;
      b.addEventListener('click', () => select(slug));
      b.addEventListener('mouseenter', () => hover(slug));
      b.addEventListener('mouseleave', () => hover(null));
      b.addEventListener('focus', () => hover(slug));
      b.addEventListener('blur', () => hover(null));
    });
    zones.forEach((z) => {
      const slug = z.dataset.shiCatZone ?? null;
      z.addEventListener('click', () => select(slug));
      z.addEventListener('mouseenter', () => hover(slug));
      z.addEventListener('mouseleave', () => hover(null));
    });
    marks.forEach((m) => {
      const slug = m.dataset.shiCat ?? null;
      m.addEventListener('mouseenter', () => hover(slug));
      m.addEventListener('mouseleave', () => hover(null));
      m.addEventListener('focus', () => hover(slug));
      m.addEventListener('blur', () => hover(null));
    });

    // Touch has no hover: the first tap on a medallion opens its label, the second follows the link.
    // A landmark whose habitat is selected already shows its label, so it navigates on the first tap.
    const closeOpen = (except?: Element) => marks.forEach((m) => { if (m !== except) m.classList.remove('is-open'); });
    root.addEventListener('pointerdown', (e) => {
      touchTap = e.pointerType === 'touch';
      if (!(e.target as Element).closest('.lm')) closeOpen();
    }, true);
    marks.forEach((m) => {
      m.addEventListener('click', (e) => {
        if (!touchTap || m.classList.contains('is-open') || m.classList.contains('is-selected')) return;
        e.preventDefault();
        closeOpen(m);
        m.classList.add('is-open');
      });
    });

    // The table's own "clear filters" resets the picker.
    document.addEventListener('shi:filter', (e) => {
      const detail = (e as CustomEvent<{ category: string | null; source: string }>).detail;
      if (detail.source === 'explorer') return;
      current = detail.category;
      render();
    });

    // Plaques size to their text once the fonts are in; a plaque never leaves the frame.
    const fit = (g: SVGGElement, rect: SVGRectElement, text: SVGTextElement, h: number, pad: number) => {
      const w = text.getComputedTextLength() + pad * 2;
      const tr = (g.getAttribute('transform') ?? '').match(/translate\(([-\d.]+) ([-\d.]+)\)/);
      const cx = tr ? parseFloat(tr[1]) : 0;
      const cy = tr ? parseFloat(tr[2]) : 0;
      let shift = 0;
      if (cx - w / 2 < 6) shift = 6 - (cx - w / 2);
      if (cx + w / 2 > sceneWidth - 6) shift = sceneWidth - 6 - (cx + w / 2);
      if (shift) g.setAttribute('transform', `translate(${cx + shift} ${cy})`);
      rect.setAttribute('x', String(-w / 2));
      rect.setAttribute('y', String(-h / 2));
      rect.setAttribute('width', String(w));
      rect.setAttribute('height', String(h));
    };
    const sizePlaques = () => {
      marks.forEach((m) => {
        const g = m.querySelector<SVGGElement>('.lm__label');
        const rect = m.querySelector<SVGRectElement>('.lm__plaque');
        const text = m.querySelector<SVGTextElement>('.lm__text');
        if (g && rect && text) fit(g, rect, text, 24, 9);
      });
      exhibits.forEach((x) => {
        const rect = x.querySelector<SVGRectElement>('.exhibit__plaque');
        const text = x.querySelector<SVGTextElement>('.exhibit__text');
        const g = rect?.parentNode as SVGGElement | null;
        if (g && rect && text) fit(g, rect, text, 32, 12);
      });
    };
    sizePlaques();
    document.fonts?.ready.then(sizePlaques);

    // Wide viewports: the strip runs nearly the window's width, inset by the page gutter. 100vw
    // counts a classic scrollbar, so its width comes off or the page would scroll sideways.
    const fitBleed = () => root.style.setProperty('--shix-sbw', `${window.innerWidth - document.documentElement.clientWidth}px`);
    fitBleed();
    window.addEventListener('resize', fitBleed);

    // Narrow viewports: the strip scrolls; in the diorama the headwaters, where the story starts, sit at its left edge.
    if (scroller) {
      const fitScroller = () => {
        const scrolls = scroller.scrollWidth > scroller.clientWidth + 2;
        if (scrolls) scroller.setAttribute('tabindex', '0');
        else scroller.removeAttribute('tabindex');
        return scrolls;
      };
      // The basin map has no left-to-right story: it opens on the river, mid-board.
      if (fitScroller() && root.dataset.scene === 'basin') scroller.scrollLeft = (scroller.scrollWidth - scroller.clientWidth) / 2;
      window.addEventListener('resize', fitScroller);
    }
    // The life cycle fish swims the loop: downstream along the lower lane, home along the
    // upper. It is mirrored, never rotated past upright, so it never swims belly up, and its
    // tail beats as it goes. On a route with stage nodes (the basin map) it grows up on the way:
    // parr-marked fry in the river, a silver smolt to the estuary, a spotted ocean adult at sea,
    // and a red spawner on the run home, swimming upstream in bursts. A fading wake trails it.
    // Reduced motion parks it near the start of the loop, tail still.
    const loop = root.querySelector<SVGPathElement>('[data-shi-cycle-path]');
    const fish = root.querySelector<SVGGElement>('[data-shi-cycle-fish]');
    if (loop && fish) {
      const total = loop.getTotalLength();
      const tail = fish.querySelector<SVGGElement>('[data-shi-fish-tail]');
      const wakes = [...root.querySelectorAll<SVGPathElement>('[data-shi-cycle-wake]')];
      wakes.forEach((w) => (w.style.strokeDasharray = `${w.dataset.shiCycleWake} ${total}`));
      // The current: a few soft swells glide round the circuit, slower than the fish.
      const flow = root.querySelector<SVGPathElement>('[data-shi-cycle-flow]');
      const SWELLS = 5;
      flow?.style.setProperty('stroke-dasharray', `34 ${total / SWELLS - 34}`);
      const flowAnim = flow?.animate([{ strokeDashoffset: 0 }, { strokeDashoffset: -total / SWELLS }], { duration: 22000, iterations: Infinity });
      // Where each stage node sits along the route, found by sampling the path.
      const nodes: [number, number][] = JSON.parse(loop.dataset.shiCycleNodes ?? '[]');
      const samples = Array.from({ length: Math.ceil(total / 2) + 1 }, (_, k) => {
        const p = loop.getPointAtLength(Math.min(k * 2, total));
        return { d: k * 2, x: p.x, y: p.y };
      });
      const at = nodes
        .map(([x, y], i) => ({ i, d: samples.reduce((a, b) => (Math.hypot(b.x - x, b.y - y) < Math.hypot(a.x - x, a.y - y) ? b : a)).d }))
        .sort((a, b) => a.d - b.d);
      const STAGE_AFTER = ['fry', 'fry', 'smolt', 'ocean', 'spawner'];
      const stageAt = (d: number) => {
        if (!at.length) return 'smolt';
        const last = [...at].reverse().find((n) => n.d <= d) ?? at[at.length - 1];
        return STAGE_AFTER[last.i] ?? 'smolt';
      };
      const PACE: Record<string, number> = { fry: 1, smolt: 1.25, ocean: 0.9, spawner: 0.75 };
      const BASE = total / 48; // units per second: about a 48 second lap
      const place = (d: number, beat: number) => {
        const p = loop.getPointAtLength(d);
        const a = loop.getPointAtLength(Math.max(d - 3, 0));
        const b = loop.getPointAtLength(Math.min(d + 3, total));
        const deg = (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
        const heading = Math.abs(deg) <= 90 ? `rotate(${deg})` : `rotate(${deg - 180}) scale(-1 1)`;
        fish.setAttribute('transform', `translate(${p.x} ${p.y}) ${heading}`);
        tail?.setAttribute('transform', `rotate(${beat} -9.5 0)`);
        fish.dataset.stage = stageAt(d);
        wakes.forEach((w) => (w.style.strokeDashoffset = String(Number(w.dataset.shiCycleWake) - d)));
      };
      const still = window.matchMedia('(prefers-reduced-motion: reduce)');
      let raf = 0;
      let last = 0;
      let dist = 0.04 * total;
      let clock = 0;
      const tick = (now: number) => {
        const dt = last ? Math.min((now - last) / 1000, 0.1) : 0;
        last = now;
        clock += dt;
        const stage = stageAt(dist);
        // upstream the spawner pushes in bursts and rests between them
        const burst = stage === 'spawner' ? 0.45 + 1.1 * Math.max(0, Math.sin(clock * 2.6)) : 1;
        dist = (dist + BASE * PACE[stage] * burst * dt) % total;
        const hz = stage === 'fry' ? 3.4 : 2.2;
        place(dist, Math.sin(clock * hz * Math.PI * 2) * 14 * Math.min(1.3, burst));
        raf = requestAnimationFrame(tick);
      };
      const run = () => {
        cancelAnimationFrame(raf);
        last = 0;
        if (still.matches) {
          place(0.04 * total, 0);
          flowAnim?.pause();
        } else {
          flowAnim?.play();
          raf = requestAnimationFrame(tick);
        }
      };
      still.addEventListener('change', run);
      run();
    }
    render();
  }
</script>

