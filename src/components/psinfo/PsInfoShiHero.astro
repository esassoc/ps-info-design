---
// PsInfoShiHero — the Salmon Habitat Indicators landing header: a two-column
// lockup of the SHI logo beside the program name (the page h1) and its
// subtitle, then the program's About paragraphs. Same identity-header idea as
// psinfo-pi-hero, which has a fixed logo aspect and no text beside it.
//
// bcn-lego-checked: checked esa-page-header (text container with no logo
// slot) and psinfo-pi-hero (logo-as-h1, fixed 1152×464 image box); no esa-
// lego pairs a logo with a heading. The logo is decorative here (alt="")
// because its wordmark repeats the h1 beside it. psinfo-shi-hero is the
// reusable home.
import { withBase } from '../../lib/base';
import type { ShiTextRun } from '../../data/pages/salmon-habitat-indicators';

interface Props {
  /** Program name, the page h1. */
  name: string;
  /** The program's own subtitle line, set under its name in prod's title band
   *  (VS: "Measures of ecosystem health…"; SHI: from the deck). */
  subtitle: string;
  logo: { src: string; width: number; height: number };
  /** PSP-authored About content stored on the landing-page record; a run is
   *  plain text or an inline link. */
  aboutParagraphs: ShiTextRun[][];
}
const { name, subtitle, logo, aboutParagraphs } = Astro.props;
---
<header class="shihero">
  <div class="shihero__lockup">
    <img class="shihero__logo" src={withBase(logo.src)} alt="" width={logo.width} height={logo.height} />
    <div class="shihero__text">
      <h1 class="shihero__title">{name}</h1>
      <p class="shihero__subtitle">{subtitle}</p>
    </div>
  </div>
  {aboutParagraphs.length > 0 && (
    <div class="shihero__about">
      {aboutParagraphs.map((p) => (
        <p>{p.map((run) => (typeof run === 'string' ? run : <a href={run.href}>{run.text}</a>))}</p>
      ))}
    </div>
  )}
</header>

<style>
  .shihero {
    display: flex; flex-direction: column; gap: var(--spacing-500);
  }
  .shihero__lockup {
    display: grid; grid-template-columns: auto 1fr; align-items: center;
    gap: var(--spacing-500);
  }
  .shihero__logo { width: 10rem; height: auto; }
  .shihero__text { display: flex; flex-direction: column; gap: var(--spacing-200); }
  .shihero__title {
    margin: 0;
    font-size: 2.25rem; font-weight: var(--font-weight-semibold); line-height: 1.15;
    color: var(--ps-info-blue-800);
  }
  .shihero__subtitle {
    margin: 0;
    font-size: 1.25rem; line-height: 1.4; color: var(--color-text-secondary);
  }
  .shihero__about {
    max-width: 50rem;
    display: flex; flex-direction: column; gap: var(--spacing-300);
    font-size: var(--ps-info-text-body); line-height: 1.6; color: var(--color-text-primary);
  }
  .shihero__about p { margin: 0; }
  .shihero__about a { color: var(--color-text-link); text-decoration: underline; text-underline-offset: 2px; }
  .shihero__about a:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: 2px; }

  @media (max-width: 640px) {
    .shihero__lockup { gap: var(--spacing-300); }
    .shihero__logo { width: 5.5rem; }
    .shihero__title { font-size: 1.5rem; }
    .shihero__subtitle { font-size: 1rem; }
  }
</style>
