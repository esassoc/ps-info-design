---
// PsInfoShiHero — the Salmon Habitat Indicators landing header, per the deck:
// the program's title band (name + subtitle, the page h1), the SHI logo, then
// the program's About paragraphs. Same identity-band idea as psinfo-pi-hero,
// which has no title band and a fixed logo aspect.
//
// bcn-lego-checked: checked esa-page-header (transparent text container — no
// filled band or logo slot) and psinfo-pi-hero (logo-as-h1, fixed 1152×464
// image box, no band); no esa- lego renders a filled title band. The logo is
// decorative here (alt="") because its wordmark repeats the h1 beside it.
// psinfo-shi-hero is the reusable home.
import { withBase } from '../../lib/base';

interface Props {
  /** Program name, the page h1. */
  name: string;
  /** The program's own subtitle line, set under its name in prod's title band
   *  (VS: "Measures of ecosystem health…"; SHI: from the deck). */
  subtitle: string;
  logo: { src: string; width: number; height: number };
  /** PSP-authored About content stored on the landing-page record. */
  aboutParagraphs: string[];
}
const { name, subtitle, logo, aboutParagraphs } = Astro.props;
---
<header class="shihero">
  <div class="shihero__band">
    <h1 class="shihero__title">{name}</h1>
    <p class="shihero__subtitle">{subtitle}</p>
  </div>
  <img class="shihero__logo" src={withBase(logo.src)} alt="" width={logo.width} height={logo.height} />
  <div class="shihero__about">
    {aboutParagraphs.map((p) => <p>{p}</p>)}
  </div>
</header>

<style>
  .shihero {
    display: flex; flex-direction: column; align-items: center; gap: var(--spacing-500);
    text-align: center;
  }
  .shihero__band {
    width: min(100%, 46rem);
    display: flex; flex-direction: column; gap: var(--spacing-100);
    padding: var(--spacing-400) var(--spacing-500);
    background: var(--shi-title-band);
    color: #ffffff;
  }
  .shihero__title {
    margin: 0;
    font-size: 1.5rem; font-weight: var(--font-weight-semibold);
    text-transform: uppercase; letter-spacing: 0.03em; line-height: 1.25;
  }
  .shihero__subtitle { margin: 0; font-size: 1rem; }
  .shihero__logo { width: min(100%, 15rem); height: auto; }
  .shihero__about {
    max-width: 46rem;
    display: flex; flex-direction: column; gap: var(--spacing-300);
    font-size: var(--ps-info-text-body); line-height: 1.6; color: var(--color-text-primary);
  }
  .shihero__about p { margin: 0; }

  @media (max-width: 640px) {
    .shihero__title { font-size: 1.25rem; }
  }
</style>
