---
// PsInfoPasswordGate: a client-side password lock in front of slotted content.
// One correct entry reveals the content and is remembered for the browser tab.
//
// SECURITY NOTE. This is a CASUAL DETERRENT, not access control:
//   - The spoke builds to static HTML (astro build, output "static") and
//     publishes to GitHub Pages from a PUBLIC repo. There is no server to
//     check a password against, so the check can only run in the visitor's
//     own browser.
//   - The password ships in plain text in the page's HTML, and it sits in the
//     public repo's source as well. Hashing or obfuscation changes nothing:
//     anything checked client-side can be read client-side.
//   - The slotted content is in the static HTML too, only under a `hidden`
//     attribute. It is not fetched or built after unlocking. Anyone who reads
//     the page source, or turns off styles, sees it.
// It keeps someone from stumbling onto the content in normal browsing. It does
// not protect the content from a determined viewer. Never use it where real
// protection is required.
//
// Unlock state lives in sessionStorage (not localStorage): tab-scoped, gone
// when the browser session ends, so a shared machine re-prompts on a fresh
// visit instead of staying unlocked indefinitely.
//
// Ported from the CBFish spoke's gate, keeping its API (password, storageKey,
// title, description) and behaviour so the two can merge when the gate moves
// to the hub. Differences to reconcile in that merge:
//   1. `description` is optional with no default; its paragraph renders only
//      when set. `title` defaults to 'Password Required'.
//   2. The content wrapper is layout-neutral (a plain block, no flex or gap).
//      Here the gate wraps whole pages, not one panel's children.
//   3. An inline script marks the gate open before first paint when the tab
//      is already unlocked, so walking several gated pages never flashes the
//      lock card. CBFish gated one page and could live with the flash.
//   4. The lock screen is a <main>: here it stands in for the whole page.
//      CBFish's lock sits inside its page's own main, so a merged gate needs a
//      prop to choose the landmark.
//   5. Enter in the field submits. The field's input lives in esa-text-field's
//      shadow root and has no form owner, so the browser's implicit
//      submission never reaches the form; the script calls requestSubmit().
//   6. autocomplete="current-password" and name="password" on the field
//      (SC 1.3.5, and the hint password managers fill from). Paste is never
//      blocked (SC 3.3.8).
//   7. A wrong password announces itself (live-error), returns focus to the
//      emptied field, and clears once the visitor types again, so a second
//      wrong attempt is announced too.
//   8. After a successful entry, focus moves to the revealed page's <main>
//      (or its h1), not to <body>.
//   9. The lock screen pads inline, so the card never forces horizontal
//      scroll at 320px (SC 1.4.10).
//  10. The embedded password JSON escapes `<`, so no value can close its
//      <script> early.
//
// bcn-lego-checked: no esa- lego is a full-page lock screen. esa-dialog is a
// modal layered over visible chrome, not a gate that stands in for content
// until a check passes; esa-empty-state is a no-data message with no form;
// esa-loading-overlay is an in-flight spinner. Checked the hub catalog
// (ls node_modules/@esa/ecology/src/components/), this spoke's
// src/components (no gate), and Beacon's shared ui components (no lock
// screen; ui-input-text maps to esa-text-field). Every control inside IS a
// lego: esa-card (surface), esa-text-field (password input, with its own
// errorText for the wrong-password message), esa-button (submit), esa-icon
// (the Lucide lock through its documented `paths` fallback, since the glyph
// is not in the registry). psinfo-password-gate is the reusable home.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import '@esa/tokens/typography.css';

interface Props {
  /** Plain-text password to check against. See the security note above. */
  password: string;
  /** sessionStorage key that remembers this gate is unlocked for the tab. */
  storageKey?: string;
  /** The lock screen's h1. */
  title?: string;
  /** Optional line under the title. Renders only when set. */
  description?: string;
}

const {
  password,
  storageKey = 'password-gate-unlocked',
  title = 'Password Required',
  description,
} = Astro.props;

// Lucide "lock": not in icon-registry.ts, so it rides esa-icon's documented
// `paths` fallback for glyphs outside the built-in set.
const lockPaths =
  '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>';

// `<` escaped so no password value can close the JSON <script> it rides in.
const passwordJson = JSON.stringify(password).replace(/</g, '\\u003c');
---
<div class="pwgate" data-pwgate data-storage-key={storageKey}>
  <!-- Runs before either part paints: a tab that already unlocked this gate
       shows the content at once instead of flashing the lock card. -->
  <script is:inline>
    (function () {
      var gate = document.currentScript && document.currentScript.parentElement;
      if (!gate) return;
      try {
        if (sessionStorage.getItem(gate.getAttribute('data-storage-key')) === '1') {
          gate.setAttribute('data-pwgate-open', '');
        }
      } catch (e) {}
    })();
  </script>

  <main class="pwgate__lock" data-pwgate-lock>
    <EsaCard variant="outlined" padding="spacious">
      <div class="pwgate__body stack" data-gap="lg">
        <div class="pwgate__icon" aria-hidden="true">
          <EsaIcon name="lock" paths={lockPaths} size="lg" />
        </div>
        <div class="stack" data-gap="xs">
          <h1 class="pwgate__title typography-title">{title}</h1>
          {description && <p class="pwgate__desc typography-body-md">{description}</p>}
        </div>
        <form class="pwgate__form stack" data-gap="md" data-pwgate-form>
          <esa-text-field
            type="password"
            label="Password"
            name="password"
            autocomplete="current-password"
            live-error
            required
            data-pwgate-input
          ></esa-text-field>
          <EsaButton type="submit" variant="primary">Unlock</EsaButton>
        </form>
      </div>
    </EsaCard>
  </main>

  <div class="pwgate__content" data-pwgate-content hidden>
    <slot />
  </div>

  <!-- The password, in plain text. See the security note above: a value that
       must be checked client-side cannot be protected. -->
  <script type="application/json" data-pwgate-password set:html={passwordJson}></script>
</div>

<style>
  /* The content wrapper holds whole pages, so it adds no layout of its own:
     a plain block that the hidden attribute hides. */
  .pwgate__content[hidden] {
    display: none;
  }

  /* Already unlocked in this tab (set by the inline script before paint):
     the content shows and the lock never paints. */
  .pwgate[data-pwgate-open] > .pwgate__lock {
    display: none;
  }
  .pwgate[data-pwgate-open] > .pwgate__content {
    display: block;
  }

  .pwgate__lock {
    display: flex;
    justify-content: center;
    padding-block: var(--spacing-800, 4rem);
    padding-inline: var(--spacing-400, 1rem);
  }
  /* Author CSS beats the UA stylesheet's [hidden] { display: none } at equal
     specificity, so the `display: flex` above would otherwise defeat
     lock.hidden = true in the script below. */
  .pwgate__lock[hidden] {
    display: none;
  }
  .pwgate__lock :global(.esa-card) {
    max-inline-size: 26rem;
    inline-size: 100%;
  }

  .pwgate__body {
    align-items: center;
    text-align: center;
  }
  .pwgate__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--spacing-700, 3rem);
    block-size: var(--spacing-700, 3rem);
    border-radius: var(--radius-full, 9999px);
    background: var(--color-surface-sunken);
    color: var(--color-text-secondary);
  }
  .pwgate__title {
    color: var(--color-text-primary);
  }
  .pwgate__desc {
    color: var(--color-text-secondary);
  }
  .pwgate__form {
    inline-size: 100%;
    text-align: start;
  }
</style>

<script>
  import '@esa/ecology/esa-text-field';

  type GateTextField = HTMLElement & { value: string; errorText: string };

  const WRONG_PASSWORD = 'Incorrect password. Try again.';

  function initGate(root: HTMLElement): void {
    const storageKey = root.dataset.storageKey ?? 'password-gate-unlocked';
    const lock = root.querySelector<HTMLElement>('[data-pwgate-lock]');
    const content = root.querySelector<HTMLElement>('[data-pwgate-content]');
    const form = root.querySelector<HTMLFormElement>('[data-pwgate-form]');
    const input = root.querySelector<GateTextField>('[data-pwgate-input]');
    const passwordEl = root.querySelector<HTMLScriptElement>('[data-pwgate-password]');
    if (!lock || !content || !form || !input || !passwordEl) return;

    const expected: string = JSON.parse(passwordEl.textContent ?? '""');

    function remembered(): boolean {
      try {
        return sessionStorage.getItem(storageKey) === '1';
      } catch {
        return false;
      }
    }

    function reveal(): void {
      lock!.hidden = true;
      content!.hidden = false;
    }

    // Already unlocked earlier this tab: straight to the content.
    if (remembered()) {
      reveal();
      return;
    }

    // Focus would otherwise fall to <body> when the lock hides. The revealed
    // page's <main> (or its h1) is where a reader picks up.
    function focusContent(): void {
      const target = content!.querySelector<HTMLElement>('main, h1');
      if (!target) return;
      if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
      target.focus({ preventScroll: true });
    }

    // The field's input sits in a shadow root with no form owner, so the
    // browser's Enter-to-submit never reaches this form.
    input.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key !== 'Enter' || e.isComposing) return;
      e.preventDefault();
      form.requestSubmit();
    });

    // Typing again clears the last error, so the next wrong attempt is a fresh
    // message the live region announces.
    input.addEventListener('change', () => {
      if (input.errorText) input.errorText = '';
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (input.value === expected) {
        try {
          sessionStorage.setItem(storageKey, '1');
        } catch {
          // Storage refused (private mode): unlock for this page view only.
        }
        reveal();
        focusContent();
      } else {
        input.value = '';
        input.errorText = WRONG_PASSWORD;
        input.focus();
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-pwgate]').forEach(initGate);
</script>
