---
// PsInfoVsiSidebar — the reference rail of prod's VitalSignIndicator/Detail
// page: Indicator Trend (prod's own progress icon), Target, Data Source,
// Vital Sign Indicator Reporter, Indicator Details with the Complete Indicator
// Report link. When the indicator has its own Salmon Habitat
// Indicator report (SHI = VSI+), a Salmon Habitat Indicator entry links to it,
// in the same place the Complete Indicator Report link lives.
//
// bcn-lego-checked: checked psinfo-vital-sign-detail-sidebar (the Vital Sign
// page's rail: Related Strategies + reporter org, no trend icon, target, data
// source or report links) and esa-card; headings in the goal ThemeColor as
// prod sets them. psinfo-vsi-sidebar is the reusable home for indicator pages.
import { withBase } from '../../lib/base';
import type { ProgressLabel } from '../../data/pages/goals';
import type { VsiReporter } from '../../data/shi-domain';

interface Props {
  /** --ps-info-goal-* token. */
  hueVar: string;
  progress: ProgressLabel;
  progressIcon: string;
  target: string;
  dataSource: string;
  reporter: VsiReporter;
  completeReportHref: string;
  /** Present when a Salmon Habitat Indicator report exists for this indicator. */
  shiReport?: { href: string };
}
const { hueVar, progress, progressIcon, target, dataSource, reporter, completeReportHref, shiReport } = Astro.props;
---
<aside class="vsiside" aria-label="Indicator reference" style={`--hue: var(${hueVar})`}>
  <section>
    <h2 class="vsiside__h">Indicator Trend</h2>
    <img class="vsiside__trend" src={withBase(`/photos/vital-signs/icons/${progressIcon}`)} alt={`Progress: ${progress}`} width="72" height="72" />
  </section>
  <section>
    <h2 class="vsiside__h">Target</h2>
    <p>{target}</p>
  </section>
  <section>
    <h2 class="vsiside__h">Data Source</h2>
    <p>{dataSource}</p>
  </section>
  <section>
    <h2 class="vsiside__h">Vital Sign Indicator Reporter</h2>
    <p>
      {reporter.name}<br />
      <a href={`mailto:${reporter.email}`}>{reporter.email}</a><br />
      <a href={reporter.organizationHref}>{reporter.organization}</a>
    </p>
  </section>
  <section>
    <h2 class="vsiside__h">Indicator Details</h2>
    <p><a href={completeReportHref}>Complete Indicator Report</a></p>
  </section>
  {shiReport && (
    <section>
      <h2 class="vsiside__h">Salmon Habitat Indicator</h2>
      <p><a href={withBase(shiReport.href)}>Salmon Habitat Indicator Report</a></p>
    </section>
  )}
</aside>

<style>
  .vsiside {
    display: flex; flex-direction: column; gap: var(--spacing-500);
    font-size: var(--ps-info-text-body); line-height: 1.5; color: var(--color-text-primary);
  }
  .vsiside section { display: flex; flex-direction: column; gap: var(--spacing-200); }
  .vsiside p { margin: 0; overflow-wrap: anywhere; }
  .vsiside__h { margin: 0; font-size: 1.0625rem; font-weight: var(--font-weight-regular); color: var(--hue); }
  .vsiside__trend { width: 72px; height: 72px; }
  .vsiside a { color: var(--color-text-link); text-decoration: underline; text-underline-offset: 2px; }
  .vsiside a:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: 2px; }
</style>
