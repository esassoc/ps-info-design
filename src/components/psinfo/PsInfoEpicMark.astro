---
// PsInfoEpicMark: a page wraps a part a story adds or changes in this.
// psinfo-epic-bar outlines and numbers these live (in page order, for the
// active story); scripts/epic-shots.mjs reads them for the story pages.
// Carries no styles of its own, so it never changes layout: `as="span"` for a
// part inside phrasing content, a div everywhere else.
//
// prose-prop-checked: `story` is a Jira key, `label` names the marked part
import { epicMarkAttrs } from '../../data/epics/index';

interface Props {
  /** Jira key of the story the part belongs to, e.g. DELTA-1343. */
  story: string;
  /** Names the marked part, e.g. "Importance to Salmon section". */
  label: string;
  as?: 'div' | 'span';
}
const { story, label, as = 'div' } = Astro.props;
const Tag = as;
---
<Tag {...epicMarkAttrs(story, label)}><slot /></Tag>
