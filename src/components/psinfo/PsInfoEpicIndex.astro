---
// PsInfoEpicIndex: the body of an epic page. One psinfo-group per story: the
// band carries the story's key (linked to Jira) and its Jira title, with an
// Overview button to the story page; the rows under it are the prototype
// pages that answer the story, the work to review. Nothing here knows which
// epic it shows. The page header, with the Start action, comes in the header
// slot.
// prose-prop-checked: `epic` is a Jira epic record (key, title, stories), never page copy
import EsaButton from '@esa/ecology/esa-button.astro';
import '@esa/tokens/typography.css';
import '@esa/tokens/layouts.css';
import type { Epic } from '../../data/epics/types';
import { epicSteps, jiraHref, stepHref, storyRoute } from '../../data/epics/index';
import { withBase } from '../../lib/base';
import PsInfoGroup from './PsInfoGroup.astro';

interface Props {
  epic: Epic;
}
const { epic } = Astro.props;
const steps = epicSteps(epic);
const groups = epic.stories.map((story) => ({
  story,
  rows: steps
    .filter((s) => s.story === story)
    .map((step) => ({ href: withBase(stepHref(epic, step)), title: step.page.title, label: step.page.label })),
}));
---
<div class="stack" data-gap="2xl">
  <slot name="header" />
  <div class="stack" data-gap="xl">
    {groups.map(({ story, rows }) => (
      <PsInfoGroup id={`epicindex-${story.key}`} rows={rows}>
        <Fragment slot="title">
          <a class="epicindex__key typography-label-md" href={jiraHref(story.key)}>{story.key}</a>
          <span>{story.title}</span>
        </Fragment>
        <EsaButton slot="actions" variant="secondary" size="sm" href={withBase(storyRoute(epic, story))}>Overview</EsaButton>
      </PsInfoGroup>
    ))}
  </div>
</div>

<style>
  /* The key is a link inside the band's heading: underlined at rest, a step
     quieter than the title it keys. */
  .epicindex__key {
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
    text-decoration: underline;
    text-decoration-thickness: var(--border-width-100);
    text-underline-offset: 0.2em;
  }
  .epicindex__key:hover { color: var(--color-text-primary); }
  .epicindex__key:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: 2px; }
</style>
