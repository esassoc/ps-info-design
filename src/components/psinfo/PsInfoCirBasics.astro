---
// PsInfoCirBasics — the Basics box of prod's Complete Indicator Report as a
// two-column definition list: goal, Vital Sign, indicator, Indicator Type,
// unit, trend and target-status icons, target, reporter, partners, last
// updated. On a Salmon Habitat Indicator the Indicator Type field carries the
// SHI mark (icon plus label, DELTA-1346).
//
// bcn-lego-checked: checked psinfo-indicators-basics (the unified-shell
// redesign of this panel: badges and a card, not prod's label/value rows) and
// esa-stat (single value). A dl inside psinfo-cir-box; the mark is
// psinfo-shi-mark. psinfo-cir-basics is the reusable home.
import PsInfoShiMark from './PsInfoShiMark.astro';
import { withBase } from '../../lib/base';
import type { VsiPartner, VsiReporter } from '../../data/shi-domain';

interface Props {
  goal: string;
  vitalSign: { name: string; href: string };
  indicator: string;
  /** Prod's Indicator Type value; omitted for a standalone SHI. */
  indicatorType?: string;
  /** The indicator is a Salmon Habitat Indicator. */
  isShi: boolean;
  /** Jira key of the story that adds the SHI mark here (epic preview). */
  shiMarkStory?: string;
  measurementUnit: string;
  trend: { label: string; icon: string };
  targetStatus?: { label: string; icon: string };
  target: string;
  reporterLabel: string;
  reporter: VsiReporter;
  partners: VsiPartner[];
  lastUpdated: string;
}
const p = Astro.props;
const icon = (file: string) => withBase(`/photos/vital-signs/icons/${file}`);
---
<dl class="cirbasics">
  <div><dt>Ecosystem Recovery Goal</dt><dd>{p.goal}</dd></div>
  <div><dt>Vital Sign</dt><dd><a href={p.vitalSign.href}>{p.vitalSign.name}</a></dd></div>
  <div><dt>Indicator</dt><dd>{p.indicator}</dd></div>
  <div>
    <dt>Indicator Type</dt>
    <dd class="cirbasics__types">
      {p.indicatorType && <span>{p.indicatorType}</span>}
      {p.isShi && <PsInfoShiMark epicStory={p.shiMarkStory} />}
    </dd>
  </div>
  <div><dt>Measurement Unit</dt><dd>{p.measurementUnit}</dd></div>
  <div>
    <dt>Indicator Trend / Target Status</dt>
    <dd class="cirbasics__icons">
      <img src={icon(p.trend.icon)} alt={`Progress: ${p.trend.label}`} width="64" height="64" />
      {p.targetStatus && <img src={icon(p.targetStatus.icon)} alt={`Target status: ${p.targetStatus.label}`} width="64" height="64" />}
    </dd>
  </div>
  <div><dt>Target</dt><dd>{p.target}</dd></div>
  <div>
    <dt>{p.reporterLabel}</dt>
    <dd>
      {p.reporter.name}<br />
      <a href={`mailto:${p.reporter.email}`}>{p.reporter.email}</a><br />
      <a href={p.reporter.organizationHref}>{p.reporter.organization}</a>
    </dd>
  </div>
  <div>
    <dt>Contributing Partners</dt>
    <dd>
      <ul class="cirbasics__partners" role="list">
        {p.partners.map((x) => <li><a href={x.href}>{x.name}</a></li>)}
      </ul>
    </dd>
  </div>
  <div><dt>Last Updated</dt><dd>{p.lastUpdated}</dd></div>
</dl>

<style>
  .cirbasics { margin: 0; display: flex; flex-direction: column; gap: var(--spacing-400); }
  .cirbasics > div { display: grid; grid-template-columns: minmax(9rem, 2fr) 3fr; gap: var(--spacing-400); }
  .cirbasics dt { color: var(--color-text-primary); }
  .cirbasics dd { margin: 0; overflow-wrap: anywhere; }
  .cirbasics__types { display: flex; flex-direction: column; align-items: flex-start; gap: var(--spacing-200); }
  .cirbasics__icons { display: flex; gap: var(--spacing-300); }
  .cirbasics__icons img { width: 64px; height: 64px; }
  .cirbasics__partners.cirbasics__partners { list-style: none; padding: 0; gap: var(--spacing-100); }
  @media (max-width: 480px) {
    .cirbasics > div { grid-template-columns: 1fr; gap: var(--spacing-100); }
    .cirbasics dt { font-weight: var(--font-weight-semibold); }
  }
</style>
