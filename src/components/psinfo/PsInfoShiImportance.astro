---
// PsInfoShiImportance — the "Importance to Salmon" subfield of the Salmon
// Habitat Indicator field, as it appears on a Vital Sign Indicator page
// (DELTA-1343): a section after Key Vital Sign Indicator Results holding the
// stored narrative. The SHI logo before the heading and the link to all Salmon
// Habitat Indicators are optional; VSI pages use both (option B, 2026-10-16).
// The indicator's type (VSI / VSI+ / SHI) is internal and never shown here:
// kickoff 2026-10-13, "I don't think they need to know type."
//
// bcn-lego-checked: the section frame is psinfo-vsi-section (goal-hue h2 +
// mark); the body is paragraphs and one link, no lego applies.
// psinfo-shi-importance is the reusable home.
import PsInfoVsiSection from './PsInfoVsiSection.astro';
import { withBase } from '../../lib/base';
import { SHI_IMPORTANCE_ANCHOR } from '../../data/pages/salmon-habitat-indicators';

interface Props {
  hueVar: string;
  /** The Importance to Salmon subfield. */
  paragraphs: string[];
  /** SHI logo before the heading; omit for a plain heading. */
  mark?: { src: string; width: number; height: number };
  /** Link to the Salmon Habitat Indicators landing page; omit for none. */
  landingHref?: string;
}
const { hueVar, paragraphs, mark, landingHref } = Astro.props;
---
<PsInfoVsiSection title="Importance to Salmon" {hueVar} {mark} id={SHI_IMPORTANCE_ANCHOR}>
  {paragraphs.map((p) => <p>{p}</p>)}
  {landingHref && <p><a href={withBase(landingHref)}>All Salmon Habitat Indicators</a></p>}
</PsInfoVsiSection>
