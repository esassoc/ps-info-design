---
// PsInfoShiGaugeGrid — the summer low flow status grid, drawn from data: one
// row per streamgage, one cell per year, purple where 50% or more of summer
// days were below normal and blue otherwise (prod's own two classes). Gauges
// the salmon analysis adds to the Vital Sign set carry a marker. A data table
// of the same values sits in a disclosure for screen-reader and keyboard use.
//
// bcn-lego-checked: checked the repo's chart components and esa-chart (line,
// bar and area series — no categorical cell matrix); the disclosure is the
// esa-collapsible lego. psinfo-shi-gauge-grid is the reusable home for gauge
// status grids. The svg scrolls inside its region below its natural width
// (WCAG 1.4.10 exempts two-dimensional charts from reflow).
import EsaCollapsible from '@esa/ecology/esa-collapsible.astro';
import type { ShiChart } from '../../data/shi-domain';

interface Props {
  chart: ShiChart;
  /** Accessible name of the chart image. */
  label: string;
}
const { chart, label } = Astro.props;

const SOURCE_CODE = { rain: 'R', transitional: 'T', snow: 'S' } as const;
const years = Array.from({ length: chart.lastYear - chart.firstYear + 1 }, (_, i) => chart.firstYear + i);
const LABEL_W = 330;
const CELL_W = 28;
const CELL_H = 20;
const TOP = 34;
const width = LABEL_W + years.length * CELL_W + 8;
const height = TOP + chart.gauges.length * CELL_H + 4;
const added = chart.gauges.filter((g) => !g.inVsi).length;
const lastIdx = years.length - 1;
const belowLast = chart.gauges.filter((g) => g.pctBelowNormal[lastIdx] >= 50).length;
const summary = `${label}. ${chart.gauges.length} streamgages, ${added} of them added for the salmon analysis, by year from ${chart.firstYear} to ${chart.lastYear}. In ${chart.lastYear}, ${belowLast} gauges had summer flows below normal on 50 percent or more of days.`;
---
<figure class="shigauge">
  <div class="shigauge__scroll" role="region" aria-label={`${label}, scrollable`} tabindex="0">
    <svg viewBox={`0 0 ${width} ${height}`} width={width} height={height} role="img" aria-label={summary}>
      <g class="shigauge__years" aria-hidden="true">
        {years.map((y, i) => (y % 5 === 0 || i === lastIdx) && (
          <text x={LABEL_W + i * CELL_W + CELL_W / 2} y={TOP - 12} text-anchor="middle">{y}</text>
        ))}
      </g>
      {chart.gauges.map((g, r) => (
        <g aria-hidden="true">
          {!g.inVsi && <circle class="shigauge__added" cx="8" cy={TOP + r * CELL_H + CELL_H / 2} r="5" />}
          <text class="shigauge__name" x="20" y={TOP + r * CELL_H + CELL_H / 2 + 5}>
            {g.name} ({SOURCE_CODE[g.source]})
          </text>
          {g.pctBelowNormal.map((v, i) => (
            <rect
              class={v >= 50 ? 'shigauge__cell shigauge__cell--below' : 'shigauge__cell'}
              x={LABEL_W + i * CELL_W}
              y={TOP + r * CELL_H}
              width={CELL_W - 2}
              height={CELL_H - 2}
            />
          ))}
        </g>
      ))}
    </svg>
  </div>

  <ul class="shigauge__legend" role="list">
    <li><span class="shigauge__swatch shigauge__swatch--below" aria-hidden="true"></span>50% or more of days below normal</li>
    <li><span class="shigauge__swatch" aria-hidden="true"></span>Fewer than 50% of days below normal</li>
    <li><span class="shigauge__dot" aria-hidden="true"></span>Not in the Vital Sign gauge set</li>
    <li>(R) rain, (T) transitional, (S) snow sourced</li>
  </ul>

  <figcaption>{chart.caption}</figcaption>

  <EsaCollapsible title="Chart data table">
    <div class="shigauge__tablewrap" role="region" aria-label="Chart data table, scrollable" tabindex="0">
      <table class="shigauge__table">
        <caption>Percent of summer days below normal flow, by streamgage and year</caption>
        <thead>
          <tr>
            <th scope="col">Streamgage</th>
            <th scope="col">USGS station</th>
            <th scope="col">In Vital Sign set</th>
            {years.map((y) => <th scope="col">{y}</th>)}
          </tr>
        </thead>
        <tbody>
          {chart.gauges.map((g) => (
            <tr>
              <th scope="row">{g.name} ({SOURCE_CODE[g.source]})</th>
              <td>{g.station}</td>
              <td>{g.inVsi ? 'Yes' : 'No'}</td>
              {g.pctBelowNormal.map((v) => <td>{v}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </EsaCollapsible>
</figure>

<style>
  .shigauge { margin: 0; display: flex; flex-direction: column; gap: var(--spacing-300); }
  .shigauge__scroll { overflow-x: auto; }
  .shigauge__scroll:focus-visible, .shigauge__tablewrap:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: 2px; }
  .shigauge__scroll svg { display: block; max-width: none; }
  .shigauge__years text { font-size: 13px; fill: var(--color-text-secondary); font-family: var(--font-sans); }
  .shigauge__name { font-size: 14px; fill: var(--color-text-primary); font-family: var(--font-sans); }
  .shigauge__cell { fill: var(--shi-chart-normal); }
  .shigauge__cell--below { fill: var(--shi-chart-below); }
  .shigauge__added { fill: var(--shi-chart-added); }

  .shigauge__legend {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: var(--spacing-200) var(--spacing-500);
    font-size: var(--ps-info-text-meta-lg); color: var(--color-text-primary);
  }
  .shigauge__legend li { display: inline-flex; align-items: center; gap: var(--spacing-200); }
  .shigauge__swatch { width: 1rem; height: 0.75rem; background: var(--shi-chart-normal); }
  .shigauge__swatch--below { background: var(--shi-chart-below); }
  .shigauge__dot { width: 0.625rem; height: 0.625rem; border-radius: 999px; background: var(--shi-chart-added); }
  .shigauge figcaption { font-size: var(--ps-info-text-meta-lg); line-height: 1.5; color: var(--color-text-secondary); }

  .shigauge__tablewrap { overflow-x: auto; max-height: 28rem; }
  .shigauge__table { border-collapse: collapse; font-size: var(--ps-info-text-meta-lg); font-variant-numeric: tabular-nums; }
  .shigauge__table caption { text-align: left; padding-bottom: var(--spacing-200); color: var(--color-text-secondary); }
  .shigauge__table th, .shigauge__table td { padding: var(--spacing-100) var(--spacing-200); border-bottom: 1px solid var(--color-border-light); text-align: right; white-space: nowrap; }
  .shigauge__table th[scope='row'], .shigauge__table thead th:first-child { text-align: left; }
  .shigauge__table thead th { position: sticky; top: 0; background: var(--color-surface); }
</style>
