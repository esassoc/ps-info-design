---
// PsInfoShiReportField — the Salmon Habitat Indicator field on the Complete
// Indicator Report (deck slide 4, PSP's preferred option; DELTA-1344): one
// new blue box where all salmon information lives, after the report's
// existing boxes. It holds each
// subfield that is switched on for the indicator AND has content, in the
// deck's order. A VSI field holds only Importance to Salmon. The indicator's
// type (VSI / VSI+ / SHI) is internal and not shown (kickoff 2026-10-13).
//
// The SHI Map and SHI Chart are the report's own Map and Chart box bodies
// (psinfo-cir-map, psinfo-cir-chart), so they take every mode those boxes do.
// In prod they belong to a linked salmon metric indicator (option 1, picked
// 2026-10-16).
//
// bcn-lego-checked: the box is psinfo-cir-box; the map and chart are
// psinfo-cir-map and psinfo-cir-chart; the rest is headings, prose and lists.
// psinfo-shi-report-field is the reusable home.
import PsInfoCirBox from './PsInfoCirBox.astro';
import PsInfoCirMap from './PsInfoCirMap.astro';
import PsInfoCirChart from './PsInfoCirChart.astro';
import { SHI_SUBFIELDS, type SalmonHabitatIndicatorField, type ShiSubfield } from '../../data/shi-domain';

interface Props {
  field: SalmonHabitatIndicatorField;
  /** Section id (the field's anchor). */
  id: string;
}
const { field, id } = Astro.props;

const hasContent = (key: ShiSubfield): boolean => {
  const value = field[key];
  return Array.isArray(value) ? value.length > 0 : value !== undefined;
};
const shown = SHI_SUBFIELDS.filter((s) => field.enabled[s.key] && hasContent(s.key));
const paragraphs = (key: ShiSubfield) => (field[key] as string[] | undefined) ?? [];
---
<PsInfoCirBox title="Salmon Habitat Indicator" {id}>
  <div class="shifield">
    {shown.map((s) => (
      <section class="shifield__sub" aria-labelledby={`shi-${s.key}`}>
        <h3 class="shifield__h" id={`shi-${s.key}`}>{s.label}</h3>
        {s.key === 'map' && field.map && (
          <PsInfoCirMap map={field.map} />
        )}
        {s.key === 'chart' && field.chart && (
          <PsInfoCirChart chart={field.chart} />
        )}
        {s.key === 'description' && <p>{field.description}</p>}
        {s.key === 'keyResults' && <ul>{paragraphs('keyResults').map((r) => <li>{r}</li>)}</ul>}
        {s.key === 'datasets' && (
          <ul>{field.datasets!.map((d) => <li>{d.name} <span class="shifield__steward">({d.steward})</span></li>)}</ul>
        )}
        {!['map', 'chart', 'description', 'keyResults', 'datasets'].includes(s.key) && paragraphs(s.key).map((p) => <p>{p}</p>)}
      </section>
    ))}
  </div>
</PsInfoCirBox>

<style>
  .shifield { display: flex; flex-direction: column; gap: var(--spacing-600); }
  .shifield__sub { display: flex; flex-direction: column; gap: var(--spacing-300); }
  .shifield__h { margin: 0; font-size: 1.25rem; font-weight: var(--font-weight-semibold); color: var(--ps-info-blue-800); }
  .shifield__steward { color: var(--color-text-secondary); }
</style>
