---
// PsInfoVsSoundExplorer — the Vital Signs home's illustrated hero (direction B):
// all of Puget Sound as a tilted tabletop, seen from the south (Olympics behind
// on the left, Cascades and Mt Baker on the right, the South Sound inlets at the
// front edge), with the 23 Vital Signs placed where each lives. A marker links
// to its Vital Sign; hover or focus opens a plaque with its name and a bar of
// its indicators' progress. A Goals / Indicators toggle (esa-button-toggle)
// swaps what is on the map: Goals shows the 23 Vital Signs; Indicators shows
// every Vital Sign Indicator (70) at a real place, each with the illustrated
// object it measures (the art's .vss-layer--goals / --indicators layers swap
// with the view). The goal buttons beneath filter either view; filtered-out
// pins fade back but stay links.
//
// The scene is generated art (vs-sound-art.svg, written by
// docs/private/briefs/vs-home-rollup/scene/vs-sound-gen.py from the Census
// 1:500k shoreline, together with data/vs-sound.ts). It shares the SHI basin
// art's palette and tree, cloud and ferry symbols. Ferries run their real
// routes, orcas surface, the water glints; prefers-reduced-motion stills all of it.
//
// bcn-lego-checked: no esa- lego renders an illustrated image map with linked markers, and esa-button-toggle / esa-chip-group have no per-option goal fill for the filter buttons (same native aria-pressed pattern as psinfo-shi-habitat-explorer); checked Beacon (no map illustration); psinfo-vs-sound-explorer is the reusable home.
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import art from './vs-sound-art.svg?raw';
import { VS_SOUND_MARKS, VS_SOUND_WIDTH, VS_SOUND_HEIGHT, type SoundGoal } from '../../data/vs-sound';
import { VS_SOUND_SITES } from '../../data/vs-sound-sites';
import type { GoalDetail, ProgressLabel } from '../../data/pages/goals';
import { withBase } from '../../lib/base';
import { isExternalHref } from '../../lib/psinfoExternalLink';

interface Props {
  goals: GoalDetail[];
}
const { goals } = Astro.props;

const GOAL_SLUG: Record<SoundGoal, string> = {
  population: 'healthy-human-population',
  quality: 'vibrant-human-quality-of-life',
  species: 'thriving-species-and-food-web',
  habitat: 'functioning-habitat',
  water: 'healthy-water-quality',
};
// Fills that hold white labels at 4.5:1 (the quality orange darkened, as the wheel does).
const GOAL_FILL: Record<SoundGoal, string> = {
  population: 'var(--ps-info-goal-population)',
  quality: 'color-mix(in srgb, var(--ps-info-goal-quality) 88%, #000000)',
  species: 'var(--ps-info-goal-species)',
  habitat: 'var(--ps-info-goal-habitat)',
  water: 'var(--ps-info-goal-water)',
};
const PROGRESS_FILL: Partial<Record<ProgressLabel, string>> = {
  'Getting Better': 'var(--ps-info-progress-better)',
  'Mixed Results': 'var(--ps-info-progress-mixed)',
  'No Trend': 'var(--ps-info-progress-notrend)',
  'Getting Worse': 'var(--ps-info-progress-worse)',
  'Limited Data': 'var(--ps-info-progress-limited)',
};
const ORDER = Object.keys(PROGRESS_FILL) as ProgressLabel[];
const INTERNAL_VS: Record<string, string> = {
  Salmon: '/prototypes/vital-signs/chinook-salmon',
  Orcas: '/prototypes/vital-signs/orcas',
};

// The art's top 90px is empty sky and its last 40px empty ground; the frame skips both.
const SKY_CROP = 90;
const GROUND_CROP = 40;
const goalBySlug = Object.fromEntries(goals.map((g) => [g.slug, g]));
const BAR_W = 96;
const marks = VS_SOUND_MARKS.map((m) => {
  const goal = goalBySlug[GOAL_SLUG[m.goal]];
  const vs = goal?.vitalSigns.find((v) => v.name === m.name);
  const href = INTERNAL_VS[m.name] ? withBase(INTERNAL_VS[m.name]) : vs?.href ?? '#';
  const inds = vs?.indicators ?? [];
  const counts = ORDER.map((p) => ({ p, n: inds.filter((i) => i.progress === p).length })).filter((c) => c.n > 0);
  const total = counts.reduce((n, c) => n + c.n, 0);
  let x = -BAR_W / 2;
  const segs = counts.map((c) => {
    const w = (c.n / total) * BAR_W;
    const seg = { x, w, fill: PROGRESS_FILL[c.p]! };
    x += w;
    return seg;
  });
  const summary = counts.map((c) => `${c.n} ${c.p}`).join(', ') || 'no indicators reported yet';
  return { ...m, goalName: goal?.name ?? '', href, segs, summary, ext: isExternalHref(href) };
});
const goalOfVs = Object.fromEntries(marks.map((m) => [m.name, m.goal]));
// Indicators view: one pin per indicator, at its place on the scene.
const sites = VS_SOUND_SITES.map((st) => {
  const goal = goalOfVs[st.vitalSign] as SoundGoal;
  const ind = goalBySlug[GOAL_SLUG[goal]]?.vitalSigns.find((v) => v.name === st.vitalSign)?.indicators.find((i) => i.name === st.indicator);
  const href = ind?.href ?? '#';
  return { ...st, goal, href, ext: isExternalHref(href) };
});
type Pin = { view: 'goals' | 'indicators'; goal: SoundGoal; x: number; y: number; href: string; ext: boolean; title: string; sub?: string; segs?: { x: number; w: number; fill: string }[]; label: string };
const pins: Pin[] = [
  ...marks.map((m) => ({ view: 'goals' as const, goal: m.goal, x: m.x, y: m.y, href: m.href, ext: m.ext, title: m.name, segs: m.segs, label: `${m.name}, ${m.goalName}: ${m.summary}` })),
  ...sites.map((st) => ({ view: 'indicators' as const, goal: st.goal, x: st.x, y: st.y, href: st.href, ext: st.ext, title: st.indicator, sub: st.place, label: `${st.indicator} (${st.vitalSign}), ${st.place}` })),
];
const buttons = (Object.keys(GOAL_SLUG) as SoundGoal[]).map((g) => ({
  goal: g,
  name: goalBySlug[GOAL_SLUG[g]]?.name ?? g,
  count: marks.filter((m) => m.goal === g).length,
  indCount: sites.filter((st) => st.goal === g).length,
}));
const CHECK = '<path d="M20 6 9 17l-5-5"/>';
const DESC =
  'Puget Sound seen from the south as a tabletop relief map: the Olympic Mountains rise along the west side on the left, the forested Cascade foothills along the east side on the right. ' +
  'Hood Canal runs down the left, the Main Basin past Seattle and Bainbridge Island in the middle, the Whidbey Basin at the back, and the South Sound inlets around Olympia at the front edge. ' +
  'Rivers run from the mountains into the Sound, farms line the valleys, ferries cross to Bainbridge, Kingston, Clinton and Vashon, and a pod of orcas surfaces in the Main Basin. ' +
  'Each of the 23 Vital Signs is marked where it lives; in the Indicators view, each of the 70 indicators is marked at a place it is measured.';
---
<div class="vss" data-vss-explorer data-view="goals" style={`--vss-scene-w: ${VS_SOUND_WIDTH}px`}>
  <div class="vss__bar">
    <esa-button-toggle class="vss__view" size="sm" label="View by" value="goals" data-vss-view></esa-button-toggle>
  </div>
  <div class="vss__stage">
  {/* WCAG 2.2.2: the ferries, orcas and water move for longer than five seconds, so the scene needs a pause; it sits quietly in the corner, as on a video. */}
  <div class="vss__controls">
    <EsaButton variant="chrome" size="sm" data-vss-pause>Pause</EsaButton>
  </div>
  <div class="vss__strip" role="region" aria-label="Puget Sound Vital Signs map" tabindex="-1">
    <div class="vss__pan">
      <div class="vss__frame">
        <svg class="vss__art" viewBox={`0 ${SKY_CROP} ${VS_SOUND_WIDTH} ${VS_SOUND_HEIGHT - SKY_CROP - GROUND_CROP}`}>
          <g role="img" aria-labelledby="vss-title vss-desc">
            <title id="vss-title">Puget Sound and its Vital Signs</title>
            <desc id="vss-desc">{DESC}</desc>
            <Fragment set:html={art} />
          </g>
          <g class="vss__marks">
            {pins.map((m) => (
              <a
                class={`vm vm--${m.view}`}
                href={m.href}
                data-vss-goal={m.goal}
                data-vss-pin={m.view}
                style={`--goal: ${GOAL_FILL[m.goal]}`}
                aria-label={m.label}
                {...(m.ext ? { target: '_blank', rel: 'noopener' } : {})}
              >
                <g transform={`translate(${m.x} ${m.y})`}>
                  {/* The illustrated object is the landmark; the pin is a small anchor at its base. Hit area stays 24px+ (WCAG 2.5.8). */}
                  <circle class="vm__hit" r="14" />
                  <ellipse class="vm__shadow" cx="1" cy="2" rx={m.view === 'goals' ? 6 : 4.5} ry={m.view === 'goals' ? 2.6 : 2} />
                  <circle class="vm__ring" r={m.view === 'goals' ? 5.5 : 4} />
                </g>
              </a>
            ))}
          </g>
          {/* Plaques in their own layer above every marker (SVG paints in DOM order). */}
          <g class="vss__labels" aria-hidden="true">
            {pins.map((m) => (
              <g transform={`translate(${m.x} ${m.y})`} style={`--goal: ${GOAL_FILL[m.goal]}`}>
                <g class="vm__label" data-dy="-22" transform="translate(0 -22)">
                  <rect class="vm__plaque" rx="3" />
                  <text class="vm__text" text-anchor="middle" y="-3">{m.title}</text>
                  {m.sub && <text class="vm__sub" text-anchor="middle" y="11">{m.sub}</text>}
                  {m.segs && (
                    <g transform="translate(0 6)">
                      {m.segs.map((sg) => <rect x={sg.x} y="0" width={Math.max(0, sg.w - 1)} height="5" rx="1" fill={sg.fill} />)}
                    </g>
                  )}
                </g>
              </g>
            ))}
          </g>
        </svg>
      </div>
    </div>
  </div>
  </div>

  <ul class="vss__buttons" role="list" aria-label="Show one goal on the map">
    {buttons.map((b) => (
      <li>
        <button type="button" class="vss__btn" style={`--goal: ${GOAL_FILL[b.goal]}`} aria-pressed="false" data-vss-goal-btn={b.goal}>
          <span class="vss__check" aria-hidden="true"><EsaIcon name="check" size="sm" paths={CHECK} /></span>
          <span class="vss__btn-name">{b.name}</span>
          <span class="vss__btn-count" data-vss-for-view="goals">{b.count} Vital Signs</span>
          <span class="vss__btn-count" data-vss-for-view="indicators">{b.indCount} indicators</span>
        </button>
      </li>
    ))}
  </ul>

  <p class="vss__live" aria-live="polite" data-vss-live></p>
</div>

<script>
  import '@esa/ecology/esa-button-toggle';
  document.querySelectorAll<HTMLElement>('[data-vss-explorer]').forEach((root) => {
    const marks = [...root.querySelectorAll<SVGAElement>('.vm')];
    const labels = [...root.querySelectorAll<SVGGElement>('.vm__label')];
    marks.forEach((m, i) => {
      const on = () => labels[i].classList.add('is-on');
      const off = () => labels[i].classList.remove('is-on');
      m.addEventListener('pointerenter', on);
      m.addEventListener('pointerleave', off);
      m.addEventListener('focus', () => { if (m.matches(':focus-visible')) on(); });
      m.addEventListener('blur', off);
    });
    // Goal filter, one goal at a time, in either view.
    const live = root.querySelector<HTMLElement>('[data-vss-live]');
    const filterBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-vss-goal-btn]')];
    let current: HTMLButtonElement | null = null;
    const apply = (btn: HTMLButtonElement | null) => {
      current = btn;
      filterBtns.forEach((o) => o.setAttribute('aria-pressed', String(o === btn)));
      marks.forEach((m) => m.classList.toggle('is-muted', !!btn && m.dataset.vssGoal !== btn.dataset.vssGoalBtn));
      if (!live) return;
      const inView = marks.filter((m) => m.dataset.vssPin === root.dataset.view && !m.classList.contains('is-muted')).length;
      const noun = root.dataset.view === 'indicators' ? 'indicators' : 'Vital Signs';
      live.textContent = btn ? `${inView} ${noun}: ${btn.querySelector('.vss__btn-name')!.textContent}` : `Showing all ${noun}`;
    };
    filterBtns.forEach((b) => b.addEventListener('click', () => apply(current === b ? null : b)));

    // Goals / Indicators view.
    const view = root.querySelector<HTMLElement & { options: unknown; value: string }>('[data-vss-view]');
    if (view) {
      view.options = [{ label: 'Goals', value: 'goals' }, { label: 'Indicators', value: 'indicators' }];
      view.addEventListener('change', () => {
        root.dataset.view = view.value;
        labels.forEach((l) => l.classList.remove('is-on'));
        apply(current);
        fit();
      });
    }

    const pause = root.querySelector<HTMLElement>('[data-vss-pause]');
    const pauseBtn = pause?.matches('button') ? pause : pause?.querySelector('button');
    pauseBtn?.addEventListener('click', () => {
      const paused = root.classList.toggle('is-paused');
      const label = pauseBtn.querySelector('.esa-button__label') ?? pauseBtn;
      label.textContent = paused ? 'Play' : 'Pause';
      pauseBtn.setAttribute('aria-label', paused ? 'Play the map animation' : 'Pause the map animation');
    });
    pauseBtn?.setAttribute('aria-label', 'Pause the map animation');
    // Wide viewports: the scene runs nearly the window's width (as psinfo-shi-habitat-explorer);
    // 100vw counts a classic scrollbar, so its width comes off or the page would scroll sideways.
    const fitBleed = () => root.style.setProperty('--vss-sbw', `${window.innerWidth - document.documentElement.clientWidth}px`);
    fitBleed();
    window.addEventListener('resize', fitBleed);
    // WCAG 1.4.13: Escape dismisses an open plaque.
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') labels.forEach((l) => l.classList.remove('is-on')); });

    // Plaques size to their text once the fonts are in, and stay inside the scene.
    const sceneW = root.querySelector<SVGSVGElement>('.vss__art')!.viewBox.baseVal.width;
    const fit = () => {
      labels.forEach((label, i) => {
        const m = marks[i];
        if (m.dataset.vssPin !== root.dataset.view) return; // hidden pins measure 0; fit them when shown
        const text = label.querySelector<SVGTextElement>('.vm__text')!;
        const sub = label.querySelector<SVGTextElement>('.vm__sub');
        const rect = label.querySelector<SVGRectElement>('.vm__plaque')!;
        const w = Math.max(text.getComputedTextLength(), sub?.getComputedTextLength() ?? 0, 96) + 20;
        rect.setAttribute('x', String(-w / 2));
        rect.setAttribute('y', '-20');
        rect.setAttribute('width', String(w));
        rect.setAttribute('height', sub ? '38' : '34');
        const cx = Number((m.querySelector('g')!.getAttribute('transform') ?? '').match(/translate\(([-\d.]+)/)?.[1] ?? 0);
        const shift = cx - w / 2 < 6 ? 6 - (cx - w / 2) : cx + w / 2 > sceneW - 6 ? sceneW - 6 - (cx + w / 2) : 0;
        label.setAttribute('transform', `translate(${shift} ${label.dataset.dy})`);
      });
    };
    (document.fonts?.ready ?? Promise.resolve()).then(fit);
  });
</script>

<style>
  .vss { position: relative; width: 100%; }
  .vss__bar { display: flex; align-items: flex-end; gap: var(--spacing-300); margin-bottom: var(--spacing-250); }
  .vss__stage { position: relative; }
  .vss__controls {
    position: absolute; z-index: 1; right: var(--spacing-250); bottom: var(--spacing-250);
    background: color-mix(in srgb, var(--shi-art-ivory) 88%, transparent); color: var(--shi-art-ivory-ink);
    border-radius: var(--radius-100);
  }
  /* Wide: the scene runs the window's width less a gutter each side; the bar and buttons keep the page column. */
  @media (min-width: 761px) {
    .vss__stage {
      --vss-bleed: min(1680px, calc(100vw - var(--vss-sbw, 0px) - 2 * var(--spacing-500)));
      width: var(--vss-bleed);
      margin-inline: calc((100% - var(--vss-bleed)) / 2);
    }
  }
  .vss__buttons[hidden] { display: none; }
  .vss__live { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .vss.is-paused :global(:is(.vss-ferry, .vss-orca use, .vss-glint, .vss-clouds, .vss-gulls)) { animation-play-state: paused; }
  .vss__strip { position: relative; }
  .vss__pan { position: relative; width: 100%; }
  .vss__frame { position: relative; border-radius: var(--radius-100); overflow: hidden; }
  .vss__art { display: block; width: 100%; height: auto; }
  @media (forced-colors: active) { .vss__btn { forced-color-adjust: none; } }

  /* Markers: an ivory ring in the goal's colour; the plaque opens on hover or focus. */
  .vm { cursor: pointer; }
  .vm:focus { outline: none; }
  .vm__hit { fill: transparent; }
  .vm__shadow { fill: #1d2a22; opacity: 0.28; }
  .vm__ring { fill: var(--goal); stroke: var(--shi-art-ivory); stroke-width: 1.8; transition: r 160ms ease, stroke-width 160ms ease, opacity 160ms ease; }
  .vm__dot { transition: opacity 160ms ease; }
  /* The view decides which pins, plaques and art layer are on the map. */
  .vss[data-view='goals'] .vm--indicators, .vss[data-view='indicators'] .vm--goals { display: none; }
  .vss[data-view='goals'] :global(.vss-layer--indicators), .vss[data-view='indicators'] :global(.vss-layer--goals) { display: none; }
  .vss[data-view='goals'] [data-vss-for-view='indicators'], .vss[data-view='indicators'] [data-vss-for-view='goals'] { display: none; }
  .vm__sub { font-family: var(--font-sans); font-size: 11.5px; fill: var(--shi-art-ivory-ink); }
  .vm--indicators .vm__ring { stroke-width: 1.5; }
  .vm--indicators:hover .vm__ring, .vm--indicators:focus-visible .vm__ring { r: 6.5; }
  .vm__dot { fill: var(--goal); }
  .vm__label { opacity: 0; pointer-events: none; transition: opacity 160ms ease; }
  .vm__plaque { fill: var(--shi-art-ivory); stroke: var(--goal); stroke-width: 2; }
  .vm__text { font-family: var(--font-display); font-size: 13px; font-weight: var(--font-weight-semibold); fill: var(--shi-art-ivory-ink); }
  .vm__label.is-on { opacity: 1; }
  .vm:hover .vm__ring, .vm:focus-visible .vm__ring { r: 8; stroke-width: 2.2; }
  .vm:focus-visible .vm__ring { stroke: var(--focus-ring-color); stroke-width: 3; }
  .vm.is-muted .vm__ring { r: 3; fill: var(--shi-art-ivory-ink); stroke-width: 1; opacity: 0.45; }
  .vm.is-muted .vm__dot, .vm.is-muted .vm__shadow { opacity: 0; }
  .vm.is-muted:hover .vm__ring, .vm.is-muted:focus-visible .vm__ring { r: 6.5; fill: var(--goal); opacity: 1; }

  /* Goal filter: the five goal colours, one pressed at a time. */
  .vss__buttons { list-style: none; margin: var(--spacing-300) 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--spacing-200); }
  .vss__buttons li { display: flex; }
  .vss__btn {
    position: relative; flex: 1; min-height: 4rem;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    padding: var(--spacing-200) 2.25rem;
    background: var(--goal); color: #ffffff; text-align: center;
    border: 3px solid transparent; border-radius: var(--radius-100);
    font: inherit; cursor: pointer;
    transition: transform 120ms ease, box-shadow 120ms ease, opacity 120ms ease;
  }
  .vss__btn-name { font-size: 1rem; font-weight: var(--font-weight-semibold); line-height: 1.25; }
  .vss__btn-count { font-size: 0.875rem; }
  .vss__btn:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(5, 31, 51, 0.22); }
  .vss__btn:focus-visible { outline: 3px solid var(--focus-ring-color); outline-offset: 3px; }
  .vss__btn[aria-pressed='true'] { border-color: var(--ps-info-gray-950); box-shadow: inset 0 0 0 2px #ffffff; }
  .vss__check {
    position: absolute; top: var(--spacing-150); right: var(--spacing-150);
    display: none; width: 1.5rem; height: 1.5rem; border-radius: 999px;
    align-items: center; justify-content: center;
    background: #ffffff; color: var(--ps-info-gray-950);
  }
  .vss__btn[aria-pressed='true'] .vss__check { display: inline-flex; }


  /* Life on the water. */
  .vss :global(.vss-ferry) { offset-distance: 0%; animation: vss-ferry 40s ease-in-out infinite alternate; }
  .vss :global([data-vss-ferry='edmonds-kingston']) { animation-duration: 34s; animation-delay: -12s; }
  .vss :global([data-vss-ferry='mukilteo-clinton']) { animation-duration: 26s; animation-delay: -6s; }
  .vss :global([data-vss-ferry='fauntleroy-vashon']) { animation-duration: 30s; animation-delay: -20s; }
  @keyframes vss-ferry { 0%, 8% { offset-distance: 0%; } 92%, 100% { offset-distance: 100%; } }
  .vss :global(.vss-orca use) { animation: vss-surface 9s ease-in-out infinite; }
  .vss :global(.vss-orca--1 use) { animation-delay: -2.4s; }
  .vss :global(.vss-orca--2 use) { animation-delay: -4.6s; }
  @keyframes vss-surface { 0%, 100% { transform: translateY(3px); opacity: 0; } 20%, 55% { transform: translateY(0); opacity: 1; } 75% { transform: translateY(3px); opacity: 0; } }
  .vss :global(.vss-glint) { animation: vss-glint 5s ease-in-out infinite; }
  .vss :global(.vss-glint:nth-of-type(3n)) { animation-delay: -1.7s; }
  .vss :global(.vss-glint:nth-of-type(3n+1)) { animation-delay: -3.3s; }
  @keyframes vss-glint { 0%, 100% { opacity: 0.15; } 50% { opacity: 0.7; } }
  .vss :global(.vss-clouds) { animation: vss-drift 70s ease-in-out infinite alternate; }
  .vss :global(.vss-gulls) { animation: vss-drift 24s ease-in-out infinite alternate; }
  @keyframes vss-drift { from { transform: translateX(-14px); } to { transform: translateX(14px); } }

  /* Narrow: the scene keeps its size and scrolls sideways; buttons stack. */
  @media (max-width: 760px) {
    .vss__strip {
      overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: thin;
      margin: 0 calc(-1 * var(--spacing-400)); padding: 0 var(--spacing-400) var(--spacing-200);
    }
    .vss__pan { width: 900px; }
    .vss__buttons { grid-template-columns: 1fr 1fr; }
    .vss__btn { padding: var(--spacing-200) 2rem var(--spacing-200) var(--spacing-300); }
  }
  @media (prefers-reduced-motion: reduce) {
    .vss__controls { display: none; }
    .vss :global(.vss-ferry), .vss :global(.vss-orca use), .vss :global(.vss-glint), .vss :global(.vss-clouds), .vss :global(.vss-gulls) { animation: none; }
    .vss :global(.vss-ferry) { offset-distance: 50%; }
    .vss :global(.vss-orca use) { opacity: 1; transform: none; }
    .vm__ring, .vm__dot, .vm__label, .vss__btn { transition: none; }
    .vss__btn:hover { transform: none; }
  }
</style>
