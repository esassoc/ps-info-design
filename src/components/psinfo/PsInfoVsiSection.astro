---
// PsInfoVsiSection — one titled body section of prod's VitalSignIndicator/Detail
// page ("Key Vital Sign Indicator Results", "Contributing Partners"): an h2 in
// the goal's ThemeColor over slotted content. An optional mark image sits
// before the title (the SHI logo on "Importance to Salmon").
//
// bcn-lego-checked: psinfo-section-title is the neutral house heading (fixed
// primary color, no goal hue or leading mark); prod colors these headings by
// goal. No esa- lego is a titled content section. psinfo-vsi-section is the
// reusable home.
import { withBase } from '../../lib/base';

interface Props {
  title: string;
  /** --ps-info-goal-* token. */
  hueVar: string;
  /** Decorative mark before the title (alt=""). */
  mark?: { src: string; width: number; height: number };
  id?: string;
}
const { title, hueVar, mark, id } = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---
<section class="vsisec" style={`--hue: var(${hueVar})`} id={id} aria-labelledby={headingId}>
  <h2 class="vsisec__title" id={headingId}>
    {mark && <img class="vsisec__mark" src={withBase(mark.src)} alt="" width={mark.width} height={mark.height} />}
    <span>{title}</span>
  </h2>
  <div class="vsisec__body">
    <slot />
  </div>
</section>

<style>
  .vsisec { display: flex; flex-direction: column; gap: var(--spacing-300); }
  .vsisec__title {
    margin: 0;
    display: flex; align-items: center; gap: var(--spacing-300);
    font-size: 1.625rem; font-weight: var(--font-weight-regular); line-height: 1.25;
    color: var(--hue);
  }
  .vsisec__mark { width: 3rem; height: auto; flex: none; }
  .vsisec__body {
    display: flex; flex-direction: column; gap: var(--spacing-300);
    font-size: var(--ps-info-text-body); line-height: 1.6; color: var(--color-text-primary);
  }
  .vsisec__body :global(p) { margin: 0; }
  .vsisec__body :global(ul) { margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: var(--spacing-200); }
  .vsisec__body :global(a) { color: var(--color-text-link); text-decoration: underline; text-underline-offset: 2px; }
  .vsisec__body :global(a:focus-visible) { outline: 2px solid var(--focus-ring-color); outline-offset: 2px; }
</style>
