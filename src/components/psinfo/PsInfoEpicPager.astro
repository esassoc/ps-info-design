---
// PsInfoEpicPager: previous, position and next through a sequence (a story
// page's place among the epic's stories). Icon buttons with the destination as
// their name, the position between them; an end of the sequence shows its
// button disabled so the pager never shifts.
//
// bcn-lego-checked: esa-pagination pages a list by events, not pages by links; the pager is two esa-button chrome icon buttons and a position, laid out with .cluster. Checked Beacon shared ui components (no link pager). psinfo-epic-pager is the reusable home.
import EsaButton from '@esa/ecology/esa-button.astro';
import '@esa/tokens/typography.css';
import '@esa/tokens/layouts.css';

interface Stop {
  href: string;
  /** The destination's name, read as "Previous: <title>". */
  title: string;
}

interface Props {
  prev?: Stop;
  next?: Stop;
  /** 1-based position in the sequence. */
  position: number;
  total: number;
}
const { prev, next, position, total } = Astro.props;
---
<nav class="cluster" data-gap="xs" aria-label="Stories">
  {prev ? (
    <EsaButton variant="chrome" size="sm" iconOnly icon="chevron-left" label={`Previous: ${prev.title}`} href={prev.href} />
  ) : (
    <EsaButton variant="chrome" size="sm" iconOnly icon="chevron-left" label="Previous" disabled />
  )}
  <span class="epicpager__pos typography-label-md">{position} of {total}</span>
  {next ? (
    <EsaButton variant="chrome" size="sm" iconOnly icon="chevron-right" label={`Next: ${next.title}`} href={next.href} />
  ) : (
    <EsaButton variant="chrome" size="sm" iconOnly icon="chevron-right" label="Next" disabled />
  )}
</nav>

<style>
  .epicpager__pos {
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
